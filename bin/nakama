#!/usr/bin/env python3
"""nakama: run pi / Claude Code workers in herdr panes. Usage: see ../skills/nakama/SKILL.md."""
import argparse
import contextlib
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "0.1.9"
REPO_DIR = Path(__file__).resolve().parent.parent
HOME = Path.home()
STATE_DIR = Path(os.environ.get("NAKAMA_STATE_DIR", str(HOME / ".local/state/nakama")))
GRACE_SEC = float(os.environ.get("NAKAMA_GRACE_SEC", "20"))
POLL_SEC = float(os.environ.get("NAKAMA_POLL_SEC", "2"))
PAUSE_SEC = 300

# User roles override bundled roles with the same name.
USER_ROLES_DIR = Path(os.environ.get("NAKAMA_USER_ROLES_DIR", str(HOME / ".config/nakama/roles")))
BUNDLED_ROLES_DIR = Path(os.environ.get("NAKAMA_ROLES_DIR", str(REPO_DIR / "roles")))
MIN_HERDR = (0, 9, 3)

MAX_ROUNDS = 2
MAX_BUDGET_MIN = 180
SLUG_CHARS = set("abcdefghijklmnopqrstuvwxyz0123456789-")
NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
# Agent-side dialogs herdr does not classify as blocked (pi extensions such as a security scanner).
PROMPT_MARKERS = ("Allow execution?",)
CHECK_SEC = 30
STALL_SEC = 600
ORCH = "orchestrator"
PUSH_KINDS = ("done", "ask", "blocker")
MESSAGE_KINDS = ("done", "ask", "answer", "info", "blocker")
MAX_INBOX = 20
SEND_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
SESSION_NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
SESSION_ABOUT_MAX = 200
# What session_key() turns a herdr pane id (w3:p1) into: a name like that would share a legacy run's inbox.
SESSION_PANE_KEY_RE = re.compile(r"^w[A-Za-z0-9]+_[A-Za-z0-9]+$")
STATUS_VALUES = ("succeeded", "partial", "failed", "needs_input")
STATUS_VALUE_RE = re.compile(r"^(" + "|".join(STATUS_VALUES) + r")\b")
STATUS_LINE_RE = re.compile(r"^(?:\*\*)?Status:[ \t]*(.*?)(?:\*\*)?[ \t]*$", re.M)
STEPS_LINE_RE = re.compile(r"^(?:\*\*)?Steps:[ \t]*(\d+)/(\d+)(?:\*\*)?[ \t]*$", re.M)
NEXT_RE = re.compile(r"^(?:\*\*)?Next:[ \t]*(\S+?)(?:\*\*)?[ \t]*$", re.M)
NEXT_HOPS = {"review", "merge", "none", "retry", "ask"}

# Verified against live wt and pi/Claude CLIs.
WT_PATH_KEY = "path"
PI_PERSONA_AS_TEXT = False
PI_READ_ARGS = ["--tools", "+grep,+find,+ls", "--exclude-tools", "edit"]
# Always pass an explicit --permission-mode: a user default of auto mode overrides the allow list.
# Project-specific commands (build tools) belong in that repo's .claude/settings.local.json.
CLAUDE_FLAGS = {
    "write": ["--permission-mode", "acceptEdits", "--allowedTools", "Bash(git status:*)", "Bash(git diff:*)",
              "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(mkdir:*)",
              "Bash(nakama send:*)", "Bash(nakama inbox:*)"],
    "read": ["--permission-mode", "default", "--allowedTools", "Bash(git diff:*)", "Bash(git log:*)",
             "Bash(git show:*)", "Bash(git status:*)", "Bash(git grep:*)", "Bash(git ls-files:*)",
             "Edit(.agent/**)", "Write(.agent/**)", "Bash(nakama send:*)", "Bash(nakama inbox:*)"],
}


def emit(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def run(cmd, cwd=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and p.returncode != 0:
        emit({"error": " ".join(cmd[:3]), "stderr": p.stderr.strip()[-500:]}, 1)
    return p


def find_key(obj, key):
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        obj = list(obj.values())
    if isinstance(obj, list):
        for item in obj:
            found = find_key(item, key)
            if found is not None:
                return found
    return None


def parse_external_json(stdout, command, expected):
    try:
        data = json.loads(stdout)
    except json.JSONDecodeError:
        emit({"error": f"{command} returned unexpected output", "stdout": stdout[:300]}, 1)
    for key, value_type in expected.items():
        value = find_key(data, key)
        if (not isinstance(value, value_type) or (isinstance(value, str) and not value)
                or (isinstance(value, list) and any(not isinstance(item, dict) for item in value))):
            emit({"error": f"{command} returned unexpected output", "stdout": stdout[:300]}, 1)
    return data


def common_body():
    path = next((d / "_common.md" for d in (USER_ROLES_DIR, BUNDLED_ROLES_DIR)
                 if (d / "_common.md").is_file()), None)
    return path.read_text().strip() if path else ""


def load_role(role):
    path = next((d / f"{role}.md" for d in (USER_ROLES_DIR, BUNDLED_ROLES_DIR)
                 if not role.startswith("_") and (d / f"{role}.md").is_file()), None)
    if path is None:
        emit({"error": f"unknown role {role}: no {role}.md in {USER_ROLES_DIR} or {BUNDLED_ROLES_DIR}"}, 2)
    def unquote(value):
        return value[1:-1] if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"" else value

    def scalar(value):
        value = value.strip()
        if value[:1] in "'\"" and value[:1] and (end := value.find(value[0], 1)) > 0:
            return value[1:end]
        return value.split("#")[0].strip()

    def parse(text):
        meta, body = {}, text
        if text.startswith("---\n"):
            head, _, body = text[4:].partition("\n---\n")
            for line in head.splitlines():
                key, sep, value = line.partition(":")
                if sep:
                    meta[key.strip()] = scalar(value)
        return meta, body

    meta, body = parse(path.read_text())
    bundled = BUNDLED_ROLES_DIR / f"{role}.md"
    # A user role with frontmatter only overrides those fields and keeps the bundled persona.
    if not body.strip() and path != bundled and bundled.is_file():
        base_meta, body = parse(bundled.read_text())
        meta = {**base_meta, **meta}
    try:
        budget = int(meta.get("budget") or 20)
    except ValueError:
        emit({"error": f"role {role}: budget must be a whole number of minutes"}, 2)
    names = meta.get("names", "").strip()
    if names.startswith("[") and names.endswith("]"):
        names = names[1:-1]
    return {
        "role": role,
        "prefix": meta.get("prefix") or role[0],
        "kind": meta.get("kind") or "pi",
        "model": meta.get("model") or None,
        "mode": meta.get("mode") or "read",
        "budget": budget,
        "names": [unquote(n.strip()) for n in names.split(",") if n.strip()],
        "spawns": meta.get("spawns", "").lower() in ("true", "yes"),
        "peers": meta.get("peers", "").lower() in ("true", "yes"),
        "path": str(path),
        "body": "\n\n".join(part for part in (common_body(), body.lstrip()) if part),
    }


def all_roles():
    stems = {p.stem for d in (USER_ROLES_DIR, BUNDLED_ROLES_DIR) for p in d.glob("*.md")
             if not p.stem.startswith("_")}
    return [load_role(stem) for stem in sorted(stems)]


def pick_name(meta, slug, taken, explicit=None):
    if explicit:
        if not NAME_RE.match(explicit) or explicit in taken:
            emit({"error": f"name {explicit!r} is invalid or already in use"}, 2)
        return explicit
    clean = "".join(c if c in SLUG_CHARS else "-" for c in slug.lower())
    stem = meta["names"][0] if meta["names"] else meta["prefix"]
    first = 2 if meta["names"] else 1
    candidates = [f"{n}-{clean}" for n in meta["names"]]
    candidates += [f"{stem}{i}-{clean}" for i in range(first, 1000)]
    for candidate in candidates:
        candidate = candidate[:32]
        if NAME_RE.match(candidate) and candidate not in taken:
            return candidate
    emit({"error": f"no free name for role {meta['role']}"}, 2)


def is_nakama_name(name, metas):
    for meta in metas:
        if re.match(rf"^{re.escape(meta['prefix'])}[0-9]+-", name):
            return True
        if any(re.match(rf"^{re.escape(n)}[0-9]*-", name) for n in meta["names"]):
            return True
    return False


def worker_env(name):
    return {
        "NAKAMA_AGENT": name,
        "GIT_SSH_COMMAND": "false",
        "GH_CONFIG_DIR": tempfile.mkdtemp(prefix="nakama-gh-"),
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
    }


def require_herdr():
    if os.environ.get("HERDR_ENV") != "1":
        emit({"error": "not inside herdr (HERDR_ENV != 1)"}, 2)


def record_path(name):
    return STATE_DIR / f"{name}.json"


def load(name):
    path = record_path(name)
    if not path.is_file():
        emit({"error": f"no record for {name}"}, 2)
    return json.loads(path.read_text())


def save(rec):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    path = record_path(rec["name"])
    # Atomic: an interrupted write must not truncate a record readable_records() would then skip.
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    try:
        tmp.write_text(json.dumps(rec, indent=2))
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def patch_record(name, **changes):
    """Read-modify-write only the given fields, so a long-running waiter cannot clobber a concurrent update."""
    rec = load(name)
    rec.update(changes)
    save(rec)


def records():
    return [json.loads(p.read_text()) for p in sorted(STATE_DIR.glob("*.json"))]


def readable_records():
    """records() is unguarded against save()'s truncate-then-write, so a listing reads and skips bad files."""
    recs = []
    for path in sorted(STATE_DIR.glob("*.json")):
        try:
            rec = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if not (isinstance(rec, dict) and isinstance(rec.get("name"), str) and rec["name"]):
            continue
        # A non-string session makes session_key()'s re.sub raise in every reader that groups records.
        if any(key in rec and rec[key] is not None and not isinstance(rec[key], str)
               for key in ("session", "orch_pane")):
            continue
        recs.append(rec)
    return recs


def session_dir(key):
    return STATE_DIR / "sessions" / key


def session_meta(key):
    try:
        meta = json.loads((session_dir(key) / "meta.json").read_text())
    except (OSError, ValueError):
        return None
    return meta if isinstance(meta, dict) else None


def save_session_meta(meta):
    path = session_dir(session_key(meta["name"])) / "meta.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    # O_EXCL temp + replace: a concurrent reader sees the old meta or the new one, never half of it.
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    tmp.unlink(missing_ok=True)  # our own leftover from a crashed run must not block O_EXCL
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(json.dumps(meta, indent=2))
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


@contextlib.contextmanager
def pane_claim_lock():
    """One flock guards meta.json and the pane claims: adoption, description and launch must not interleave."""
    claims = STATE_DIR / "sessions" / ".by-pane"
    claims.mkdir(parents=True, exist_ok=True)
    fd = os.open(claims / ".lock", os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        try:
            yield claims
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
    finally:
        os.close(fd)


def claim_text(path):
    try:
        return path.read_bytes().decode("ascii", errors="replace").strip()
    except FileNotFoundError:
        return ""


def session_keys():
    try:
        return sorted(p.name for p in (STATE_DIR / "sessions").iterdir()
                      if p.is_dir() and not p.name.startswith("."))  # .by-pane holds pane claims
    except OSError:
        return []


def sessions_on_disk():
    metas = ((key, session_meta(key)) for key in session_keys())
    return {key: meta for key, meta in metas if meta is not None}


def session_owned_by_pane(meta, pane, terminal):
    return (meta is not None and meta.get("owner_pane") == pane
            and (meta.get("owner_terminal") is None or terminal is None
                 or meta.get("owner_terminal") == terminal))


def session_liveness(meta, agent):
    if agent is None:
        return False, False
    recorded_terminal = meta.get("owner_terminal")
    terminal = agent_terminal(agent)
    if recorded_terminal and terminal and recorded_terminal != terminal:
        return False, True
    token = meta.get("agent")
    if isinstance(token, dict):
        current = agent_session_token(agent)
        if current is None:
            return False, False
        if current["value"] != token.get("value"):
            return False, True
    return True, False


def current_session_with_source():
    named = os.environ.get("NAKAMA_SESSION")
    if named:
        return named, "env"
    pane = os.environ.get("HERDR_PANE_ID")
    if pane:
        terminal = None
        terminal_checked = False
        owners = []
        for key, meta in sessions_on_disk().items():
            if meta.get("owner_pane") != pane:
                continue
            if meta.get("owner_terminal") is not None and not terminal_checked:
                terminal = pane_terminal(pane)
                terminal_checked = True
            if session_owned_by_pane(meta, pane, terminal):
                owners.append(key)
        # Ambiguity means a recycled pane or a failed terminal lookup: binding the first match in
        # glob order would hand this run another session's workers, so stay unnamed instead.
        if len(owners) == 1:
            return owners[0], "pane"
        return pane, "pane_id"
    return "default", "default"


def current_session():
    return current_session_with_source()[0]


def session_key(session):
    key = re.sub(r"[^A-Za-z0-9_-]", "_", session or "default")
    return key or "default"


def record_session(rec):
    return session_key(rec.get("session") or rec.get("orch_pane") or "default")


def agent_dir(rec):
    return Path(rec["worktree"], ".agent", rec["name"])


def live_names():
    data = parse_external_json(
        run(["herdr", "agent", "list"]).stdout, "herdr agent list", {"agents": list})
    return [a["name"] for a in find_key(data, "agents")
            if isinstance(a, dict) and isinstance(a.get("name"), str) and a["name"]]


def agent_status(name):
    p = run(["herdr", "agent", "get", name], check=False)
    if p.returncode != 0:
        return None
    data = parse_external_json(p.stdout, "herdr agent get", {"agent_status": str})
    return find_key(data, "agent_status")


def pane_agent(pane):
    if not isinstance(pane, str) or not pane:
        return None
    try:
        p = run(["herdr", "agent", "get", pane], check=False)
    except OSError:
        return None
    if p.returncode != 0:
        return None
    try:
        agent = json.loads(p.stdout)["result"]["agent"]
    except (json.JSONDecodeError, KeyError, TypeError):
        return None
    return agent if isinstance(agent, dict) else None


def agent_terminal(agent):
    terminal = (agent or {}).get("terminal_id")
    return terminal if isinstance(terminal, str) and terminal else None


def pane_terminal(pane):
    return agent_terminal(pane_agent(pane))


def agent_session_token(agent):
    session = (agent or {}).get("agent_session")
    if not isinstance(session, dict):
        return None
    agent_name, kind, value = (session.get(key) for key in ("agent", "kind", "value"))
    if not all(isinstance(part, str) and part for part in (agent_name, kind, value)):
        return None
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = None
    return {"agent": agent_name, "kind": kind, "value": value,
            "source": f"herdr:{agent_name}", "cwd": cwd}


def pane_agent_session(pane):
    return agent_session_token(pane_agent(pane))


def resume_command(token):
    if not isinstance(token, dict) or not isinstance(token.get("value"), str):
        return None
    if token.get("agent") == "pi":
        return f"pi --session {shlex.quote(token['value'])}"
    if token.get("agent") == "claude":
        return f"claude --resume {shlex.quote(token['value'])}"
    return None


def visible(name):
    return run(["herdr", "agent", "read", name, "--source", "visible"], check=False).stdout


def screen(name):
    # recent-unwrapped is refused while an agent is working; the visible screen always works.
    p = run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "60"], check=False)
    return p.stdout if p.returncode == 0 else visible(name)


def parse_result_status(text):
    status_line = STATUS_LINE_RE.search(text)
    status_value = status_line.group(1).strip() if status_line else None
    status_match = STATUS_VALUE_RE.match(status_value or "")
    return status_value, status_match.group(1) if status_match else None, status_line is not None


def fresh_result(rec):
    result = agent_dir(rec) / "result.md"
    if not rec.get("prompted_at") or not result.is_file() or result.stat().st_mtime <= rec["prompted_at"]:
        return None, None, None
    text = result.read_text()
    status_value, status, has_status_line = parse_result_status(text)
    next_match = NEXT_RE.search(text)
    next_hop = next_match.group(1) if next_match and next_match.group(1) in NEXT_HOPS else None
    hint = None
    if status is None:
        allowed = ", ".join(STATUS_VALUES)
        got = f" (got {json.dumps(status_value)})" if has_status_line else ""
        hint = f"Status must be exactly one of {allowed}{got}"
    return (status or "malformed"), next_hop, hint


def task_steps(rec):
    task = agent_dir(rec) / "task.md"
    if not task.is_file():
        return 0
    lines = task.read_text().splitlines()
    start = next((i for i, line in enumerate(lines) if line.rstrip() == "## Steps"), None)
    if start is None:
        return 0
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    count = 0
    for line in lines[start + 1:end]:
        stripped = line.lstrip()
        number, dot, rest = stripped.partition(".")
        if dot and number.isdecimal() and rest[:1].isspace():
            count += 1
    return count


def steps_done(rec):
    if not rec.get("base") or not rec.get("worktree"):
        return None
    try:
        merge_base = run(["git", "merge-base", rec["base"], "HEAD"], cwd=rec["worktree"], check=False)
        if merge_base.returncode != 0 or not merge_base.stdout.strip():
            return None
        log = run(["git", "log", f"{merge_base.stdout.strip()}..HEAD",
                   "--format=%(trailers:key=Nakama-Step,valueonly)"], cwd=rec["worktree"], check=False)
    except OSError:
        return None
    if log.returncode != 0:
        return None
    done = set()
    for value in log.stdout.splitlines():
        try:
            done.add(int(value.strip().split("/", 1)[0]))
        except ValueError:
            pass
    return len(done)


def steps_info(rec):
    total = task_steps(rec)
    if not total:
        return None
    result = agent_dir(rec) / "result.md"
    match = STEPS_LINE_RE.search(result.read_text()) if result.is_file() else None
    reported = f"{match.group(1)}/{match.group(2)}" if match else None
    return {"done": steps_done(rec), "total": total, "reported": reported}


def worktree_dirty(rec):
    try:
        # --no-optional-locks: a read-only caller must not let status refresh and rewrite the index.
        result = run(["git", "--no-optional-locks", "status", "--porcelain", "--", ".",
                      ":(exclude).agent"], cwd=rec["worktree"], check=False)
    except OSError:
        return False
    return result.returncode == 0 and bool(result.stdout)


def progress_note(rec, dirty=True):
    parts = []
    total = task_steps(rec)
    done = steps_done(rec) if total else None
    if total and done is not None:
        if done >= total:
            parts.append(f" All {total} steps are committed (Nakama-Step trailers); run the full ## Acceptance.")
        elif done:
            parts.append(f" Steps 1..{done} are committed (Nakama-Step trailers); "
                         f"continue at step {done + 1} of ## Steps.")
        else:
            parts.append(" No step is committed yet; start at step 1 of ## Steps.")
    if dirty and rec.get("mode") == "write" and worktree_dirty(rec):
        parts.append(" The worktree has uncommitted changes from before the pause: read ## Resume in "
                     "result.md and git diff, continue from there, and do not discard them.")
    return "".join(parts)


def git_state(rec):
    """HEAD, stash list and a content hash of the tree (minus .agent/) of the worker's checkout; None if not git."""
    def git(*args, cwd=rec["worktree"], env=None):
        p = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True, env=env)
        return p.stdout.strip() if p.returncode == 0 else None
    top = git("rev-parse", "--show-toplevel")
    head = git("rev-parse", "HEAD")
    if top is None or head is None:
        return None
    index = git("rev-parse", "--path-format=absolute", "--git-path", "index", cwd=top)
    with tempfile.TemporaryDirectory(prefix="nakama-index-") as tmp:
        # A scratch copy of the index: add -A hashes every changed and untracked file's content without touching the real one.
        if Path(index).is_file():
            shutil.copy(index, Path(tmp, "index"))
        env = {**os.environ, "GIT_INDEX_FILE": str(Path(tmp, "index"))}
        git("add", "-A", "--", ".", ":(exclude).agent", cwd=top, env=env)
        tree = git("write-tree", cwd=top, env=env)
    branch = git("symbolic-ref", "--short", "-q", "HEAD", cwd=top) or "(no branch)"
    stash_subjects = git("stash", "list", "--format=%gs", cwd=top) or ""
    own_stashes = [subject for subject in stash_subjects.splitlines()
                   if subject.startswith((f"WIP on {branch}:", f"On {branch}:"))]
    return {"head": head, "stash": "\n".join(own_stashes), "tree": tree}


def spent_minutes(rec):
    """Minutes spent on the current prompt, including the stretches before an earlier pause."""
    spent = rec.get("spent_min", 0)
    if rec.get("prompted_at"):
        spent += (time.time() - rec["prompted_at"]) / 60
    return spent


def over_budget(rec):
    return spent_minutes(rec) > rec["budget_min"] + rec["extended_min"]


def agent_args(rec, meta):
    persona = agent_dir(rec) / "persona.md"
    persona.write_text(meta["body"])
    if rec["kind"] == "pi":
        args = ["--approve", "--append-system-prompt", meta["body"] if PI_PERSONA_AS_TEXT else str(persona)]
        if rec["mode"] == "read":
            args += PI_READ_ARGS
    else:
        args = ["--append-system-prompt-file", str(persona), *CLAUDE_FLAGS[rec["mode"]]]
    if rec.get("model"):
        args += ["--model", rec["model"]]
    return args


def check_parent_permission():
    parent = os.environ.get("NAKAMA_AGENT")
    if parent:
        parent_role = json.loads(record_path(parent).read_text())["role"] if record_path(parent).is_file() else None
        if not (parent_role and load_role(parent_role)["spawns"]):
            emit({"error": f"agent {parent} may not launch agents: its role needs 'spawns: true'"}, 2)


def close_worker_surface(rec):
    if rec.get("tab"):
        run(["herdr", "tab", "close", rec["tab"]], check=False)
    else:
        run(["herdr", "pane", "close", rec["pane"]], check=False)
    if rec.get("gh_config_dir"):
        # Only the dir recorded at launch is nakama's to delete.
        shutil.rmtree(rec["gh_config_dir"], ignore_errors=True)


def stop_worker(rec):
    """Interrupt a worker that will not write a Resume note, then drop any index lock it left held."""
    run(["herdr", "agent", "send-keys", rec["name"], "ctrl+c", "ctrl+c"], check=False)
    close_worker_surface(rec)
    if not rec.get("branch"):
        # --no-worktree workers run in the orchestrator's own checkout: that lock is not ours to delete.
        return
    lock = run(["git", "rev-parse", "--path-format=absolute", "--git-path", "index.lock"],
               cwd=rec["worktree"], check=False)
    if lock.returncode == 0 and lock.stdout.strip():
        Path(lock.stdout.strip()).unlink(missing_ok=True)


def start_worker(rec, meta, layout="tab", direction="right", patch_existing=False):
    # A tab per agent keeps the caller's pane full-size; the herdr sidebar lists every agent.
    # Target the caller's own workspace/pane: herdr's defaults follow focus, which may be elsewhere.
    if layout == "tab":
        workspace = os.environ.get("HERDR_WORKSPACE_ID")
        surface = ["herdr", "tab", "create", *(["--workspace", workspace] if workspace else []),
                   "--label", rec["name"], "--cwd", rec["worktree"], "--no-focus"]
    else:
        pane = os.environ.get("HERDR_PANE_ID")
        surface = ["herdr", "pane", "split", *(["--pane", pane] if pane else ["--current"]),
                   "--direction", direction, "--cwd", rec["worktree"], "--no-focus"]
    for key, value in worker_env(rec["name"]).items():
        surface += ["--env", f"{key}={value}"]
    expected = {"pane_id": str}
    if layout == "tab":
        expected["tab_id"] = str
    command = "herdr tab create" if layout == "tab" else "herdr pane split"
    created = parse_external_json(run(surface).stdout, command, expected)
    rec["pane"] = find_key(created, "pane_id")
    rec["tab"] = find_key(created, "tab_id") if layout == "tab" else None
    # The GH_CONFIG_DIR worker_env made: teardown removes exactly this one and nothing else.
    rec["gh_config_dir"] = next(v.split("=", 1)[1] for v in surface if v.startswith("GH_CONFIG_DIR="))
    if patch_existing:
        patch_record(rec["name"], pane=rec["pane"], tab=rec["tab"], gh_config_dir=rec["gh_config_dir"],
                     closed=rec["closed"], prompted_at=rec["prompted_at"], nudged_at=rec["nudged_at"],
                     screen_sig=rec["screen_sig"], screen_changed_at=rec["screen_changed_at"])
    else:
        save(rec)
    return run(["herdr", "agent", "start", rec["name"], "--kind", rec["kind"], "--pane", rec["pane"],
                "--timeout", "60000", "--", *agent_args(rec, meta)], check=False)


def launcher_orch_pane():
    """A nested worker inherits the root orchestrator pane used for completion nudges."""
    parent = os.environ.get("NAKAMA_AGENT")
    if parent and record_path(parent).is_file():
        return load(parent).get("orch_pane")
    return os.environ.get("HERDR_PANE_ID")


def refresh_session_agent(session):
    """Record the launching pane's resume token without ever clobbering one with None."""
    key = session_key(session)
    if session_meta(key) is None:
        return
    token = pane_agent_session(launcher_orch_pane())
    if token is None:
        return
    # Re-read under the lock: a takeover or `session about` may have saved since the caller looked.
    with pane_claim_lock():
        meta = session_meta(key)
        if meta is not None:
            save_session_meta({**meta, "agent": token})


def launcher_session():
    parent = os.environ.get("NAKAMA_AGENT")
    if parent and record_path(parent).is_file():
        rec = load(parent)
        return rec.get("session") or rec.get("orch_pane") or "default"
    return current_session()


def cmd_launch(a):
    require_herdr()
    check_parent_permission()
    meta = load_role(a.role)
    if (a.kind or meta["kind"]) not in ("pi", "claude") or meta["mode"] not in CLAUDE_FLAGS:
        emit({"error": f"role {a.role}: kind must be pi|claude and mode read|write"}, 2)
    taken = set(live_names()) | {r["name"] for r in records()}
    name = pick_name(meta, a.slug, taken, a.name)
    branch = None
    base = None
    kind = a.kind or meta["kind"]
    model = a.model or (meta["model"] if kind == meta["kind"] else None)
    if a.join:
        builder = load(a.join)
        if (builder["kind"], builder.get("model")) == (kind, model):
            emit({"error": f"joined worker {a.join} already runs {kind} {model or '(default model)'}: "
                           "pass --model (or --kind) to differ"}, 2)
        worktree = builder["worktree"]
    elif a.no_worktree:
        worktree = os.getcwd()
    else:
        branch = f"agent/{name}"
        out = run(["wt", "switch", "-c", branch, "--base", a.base, "--no-cd", "--yes", "--format", "json"]).stdout
        worktree = find_key(
            parse_external_json(out, "wt switch", {WT_PATH_KEY: str}), WT_PATH_KEY)
        run(["wt", "step", "copy-ignored", "--require-include"], cwd=worktree)
        base = a.base
        if base == "HEAD":
            ref = run(["git", "symbolic-ref", "--short", "-q", "HEAD"], check=False).stdout.strip()
            base = ref or run(["git", "rev-parse", "HEAD"], check=False).stdout.strip() or None
    rec = {
        "name": name, "role": a.role, "kind": kind, "model": model,
        "mode": meta["mode"], "pane": None, "tab": None, "layout": a.layout,
        "direction": a.direction, "worktree": worktree, "branch": branch, "base": base,
        "budget_min": a.budget or meta["budget"], "extended_min": 0, "prompted_at": None,
        "nudged_at": None, "screen_sig": None, "screen_changed_at": None,
        "rounds": 0, "closed": False, "orch_pane": launcher_orch_pane(),
        "session": launcher_session(),
    }
    agent_dir(rec).mkdir(parents=True, exist_ok=True)
    refresh_session_agent(rec["session"])
    started = start_worker(rec, meta, a.layout, a.direction)
    out = {"name": name, "pane": rec["pane"], "worktree": worktree, "branch": branch, "dir": str(agent_dir(rec))}
    if started.returncode != 0:
        emit({**out, "status": "blocked", "stderr": started.stderr.strip()[-300:], "screen": screen(name)})
    emit({**out, "status": "ready"})


def cmd_resume(a):
    require_herdr()
    check_parent_permission()
    rec = load(a.name)
    was_paused = rec.get("paused", False)
    was_forced = rec.get("paused_forced", False)
    worktree = Path(rec["worktree"])
    task = agent_dir(rec) / "task.md"
    if not worktree.is_dir():
        emit({"error": f"worktree {worktree} does not exist"}, 2)
    if not task.is_file():
        emit({"error": f"{task} does not exist"}, 2)
    meta = load_role(rec["role"])
    if rec.get("kind") not in ("pi", "claude") or rec.get("mode") not in CLAUDE_FLAGS:
        emit({"error": f"record for {rec['name']} has invalid kind or mode"}, 2)
    state = agent_status(rec["name"]) if not rec.get("closed") else None
    if state is not None and rec.get("prompted_at") is not None:
        emit({"name": rec["name"], "status": "already_live"})

    layout = rec.get("layout") or ("tab" if rec.get("tab") else "split")
    if state is None:
        if not rec.get("closed"):
            close_worker_surface(rec)
        # Keep paused/paused_forced/pause_sent_at: if the start or the prompt below fails, the record
        # must still say it is paused, or a retry of `resume` loses the forced-pause warning.
        rec.update(closed=False, prompted_at=None, nudged_at=None,
                   screen_sig=None, screen_changed_at=None)
        started = start_worker(rec, meta, layout, rec.get("direction", "right"), patch_existing=True)
        if started.returncode != 0:
            out = {"name": rec["name"], "pane": rec["pane"], "worktree": rec["worktree"]}
            emit({**out, "status": "blocked", "stderr": started.stderr.strip()[-300:], "screen": screen(rec["name"])})

    pause_file = agent_dir(rec) / "pause.md"
    pause_retired = pause_file.exists()
    if pause_retired:
        pause_file.rename(pause_file.with_name(f"pause-{int(time.time())}.done.md"))
    if pause_retired or was_paused:
        for mail in unread(rec["name"]):
            _, sender, kind, _ = mail.name.split(".")
            if sender == ORCH and kind == "info" and mail.read_text().startswith("Pause now."):
                mail.rename(mail.with_suffix(".read"))

    message = ("You are being resumed after a restart. Re-read "
               f".agent/{rec['name']}/task.md and every fix-*.md next to it, check `git log` and `git status` "
               "in this worktree to see what is already done, then continue and write result.md as required.")
    message += progress_note(rec)
    if pause_retired or was_paused:
        message += " The earlier pause is over: do not pause again."
    if was_forced:
        message += (" The earlier pause was forced before a Resume note was written: check every uncommitted "
                    "file for half-finished edits before continuing.")
    prompted_at = time.time()
    # A read worker keeps its original baseline, so a reviewer crash does not forgive what it did before.
    before = rec["git_before"] if rec["mode"] == "read" and rec.get("git_before") else git_state(rec)
    prompted = run(["herdr", "agent", "prompt", rec["name"], message], check=False)
    if prompted.returncode != 0:
        emit({"name": rec["name"], "status": "prompt_failed", "stderr": prompted.stderr.strip()[-300:]}, 1)
    patch_record(rec["name"], prompted_at=prompted_at, git_before=before, receipt=None, nudged_at=None,
                 paused=False, paused_forced=False, pause_sent_at=None,
                 screen_sig=None, screen_changed_at=None)
    emit({"name": rec["name"], "status": "fresh_primed", "pane": rec["pane"],
          "worktree": rec["worktree"], "rounds": rec["rounds"]})


def cmd_prompt(a):
    rec = load(a.name)
    task = agent_dir(rec) / Path(a.file).name
    if not task.is_file():
        emit({"error": f"{task} does not exist"}, 2)
    if agent_status(rec["name"]) == "working":
        emit({"name": rec["name"], "status": "busy", "rounds": rec["rounds"]})
    if task.name.startswith("fix-") and not a.answer:
        if rec["rounds"] >= MAX_ROUNDS:
            emit({"name": rec["name"], "status": "round_limit", "rounds": rec["rounds"]})
        rec["rounds"] += 1
    rel = task.relative_to(rec["worktree"])
    prompted_at = time.time()
    # The review receipt and, for read-only workers, the baseline their effect is checked against.
    before = git_state(rec)
    message = f"Read {rel} and do it. Write result.md with Status exactly one of succeeded, partial, failed, needs_input."
    if task.name == "task.md":
        message += progress_note(rec, dirty=False)
    run(["herdr", "agent", "prompt", rec["name"], message])
    # Saved only once the prompt reached the agent: a failed prompt spends no round and no time.
    changes = {
        "prompted_at": prompted_at, "git_before": before, "receipt": None, "nudged_at": None,
        "extended_min": 0, "spent_min": 0, "screen_sig": None, "screen_changed_at": None,
    }
    if task.name.startswith("fix-") and not a.answer:
        changes["rounds"] = rec["rounds"]
    patch_record(rec["name"], **changes)
    emit({"name": rec["name"], "status": "prompted", "file": str(rel), "rounds": rec["rounds"]})


def cmd_wait(a):
    rec = load(a.name)
    if not rec.get("prompted_at"):
        emit({"error": f"{rec['name']} was never prompted"}, 2)
    deadline = time.time() + a.timeout
    stall_sec = float(os.environ.get("NAKAMA_STALL_SEC", str(STALL_SEC)))
    me = os.environ.get("NAKAMA_AGENT", ORCH)

    def done(status, **extra):
        emit({"name": rec["name"], "status": status, "rounds": rec["rounds"],
              "result": str(agent_dir(rec) / "result.md"), **extra})

    while True:
        state = agent_status(rec["name"])
        status, next_hop, hint = fresh_result(rec)
        # A fresh result counts only once the agent has settled: it may still commit or rewrite it.
        if status and state in ("idle", "done", None):
            extra = {}
            before = rec.get("git_before")
            if before and rec["mode"] == "read":
                if not rec.get("receipt"):
                    # Taken once, at the first settled result: later checks would blame the worker for the builder's moves.
                    # pi keeps bash and write in read mode, so that mode is only an instruction: fail closed on its effect.
                    now = git_state(rec)
                    bad = now is None or any(now[k] != before[k] for k in ("head", "stash", "tree"))
                    receipt = {"status": "tampered" if bad else status, "reviewed_head": before["head"],
                               "head_at_result": now and now["head"]}
                    rec["receipt"] = receipt
                    patch_record(rec["name"], receipt=receipt)
                if rec["receipt"]["status"] == "tampered":
                    done("tampered", reason="read-only worker changed HEAD, the stash or files outside .agent/")
                extra["reviewed_head"] = rec["receipt"]["reviewed_head"]
            # The result is the report: a done mail from this agent would only make the next wait return early.
            for f in unread(me):
                if f.name.split(".")[1:3] == [rec["name"], "done"]:
                    f.unlink()
            if next_hop:
                extra["next"] = next_hop
            if hint:
                extra["hint"] = hint
            if status == "succeeded" and not next_hop:
                extra["warnings"] = ["no_next_hop"]
            if info := steps_info(rec):
                extra["steps"] = info
                if (info["reported"] and info["done"] is not None
                        and int(info["reported"].split("/", 1)[0]) != info["done"]):
                    extra.setdefault("warnings", []).append("steps_mismatch")
            done(status, **extra)
        # Unread mail makes every wait return at once: read it with nakama inbox.
        if mail := unread(me):
            done("message", messages=[str(f) for f in mail])
        if state is None:
            done("failed", reason="agent or pane gone")
        if state == "blocked":
            done("blocked", screen=screen(rec["name"]))
        if over_budget(rec):
            done("over_budget", screen=screen(rec["name"]))
        if state == "working":
            current = visible(rec["name"])
            # Only the last 10 non-empty lines are live: code or a log higher up can quote a marker.
            tail = [line for line in current.splitlines() if line.strip()][-10:]
            if any(marker in line for line in tail for marker in PROMPT_MARKERS):
                done("blocked", screen=current)
            screen_sig = re.sub(r"[^A-Za-z]+", "", current)
            now = time.time()
            if screen_sig != rec.get("screen_sig"):
                rec.update(screen_sig=screen_sig, screen_changed_at=now)
                patch_record(rec["name"], screen_sig=screen_sig, screen_changed_at=now)
            else:
                idle_seconds = now - rec.get("screen_changed_at", now)
                if idle_seconds >= stall_sec:
                    done("stalled", screen=current, idle_seconds=int(idle_seconds))
        settled = state in ("idle", "done")
        since = time.time() - max(rec["prompted_at"], rec["nudged_at"] or 0)
        if settled and since >= GRACE_SEC:
            if rec["nudged_at"]:
                done("failed", reason="no fresh result.md after one nudge")
            rec["nudged_at"] = time.time()
            patch_record(rec["name"], nudged_at=rec["nudged_at"])
            rel = agent_dir(rec).relative_to(rec["worktree"])
            run(["herdr", "agent", "prompt", rec["name"], f"Write {rel}/result.md as your task file requires."],
                check=False)
            continue
        remaining = deadline - time.time()
        if remaining <= 0:
            done("running")
        if not settled:
            ms = int(max(min(remaining, CHECK_SEC) * 1000, 3000))
            run(["herdr", "agent", "wait", rec["name"], "--timeout", str(ms)], check=False)
        time.sleep(POLL_SEC)


def inbox_dir(name, session=None):
    """Orchestrator mail is session-scoped; each worker's inbox lives in its .agent dir."""
    if name == ORCH:
        return STATE_DIR / "inbox" / ORCH / session_key(session or current_session())
    return agent_dir(load(name)) / "inbox" if record_path(name).is_file() else None


def unread(name):
    box = inbox_dir(name)
    return sorted(box.glob("*.md")) if box and box.is_dir() else []


def send_one(sender, recipient, kind, src, message_id, live_status=None):
    sender_rec = load(sender) if sender != ORCH and record_path(sender).is_file() else None
    box = inbox_dir(recipient, record_session(sender_rec) if recipient == ORCH and sender_rec else None)
    if box is None or recipient == sender:
        emit({"error": f"no agent {recipient} to message (or it is you)"}, 2)
    # Workers report to the orchestrator; talking to a peer needs the role's 'peers: true'.
    if sender != ORCH and recipient != ORCH:
        role = load(sender)["role"] if record_path(sender).is_file() else None
        if not (role and load_role(role)["peers"]):
            emit({"error": f"agent {sender} may only message {ORCH}: its role needs 'peers: true'"}, 2)
    src = Path(src)
    box.mkdir(parents=True, exist_ok=True)
    id_file = box / ".ids" / f"{sender}.{message_id}" if message_id is not None else None
    if id_file is not None and id_file.is_file():
        return {"to": recipient, "from": sender, "status": "duplicate", "id": message_id}
    if not src.is_file():
        emit({"error": f"{src} does not exist"}, 2)
    # File names are <ns>.<sender>.<kind>.md|read; agent names never contain a dot.
    if sum(1 for f in box.iterdir() if f.is_file() and len(f.name.split(".")) > 1
           and f.name.split(".")[1] == sender) >= MAX_INBOX:
        return {"to": recipient, "status": "inbox_full", "limit": MAX_INBOX}
    dest = box / f"{time.time_ns()}.{sender}.{kind}.md"
    dest.write_text(src.read_text())
    if id_file is not None:
        # A crash before recording the id may duplicate, never lose; overlapping retries can both deliver, so retries assume sequential calls.
        id_file.parent.mkdir(parents=True, exist_ok=True)
        id_file.touch()
    pushed = False
    # The orchestrator is not inside `wait` when a worker finishes: poke its pane. herdr rejects
    # the prompt (agent_blocked) before sending any key if a dialog is open, so mail then stays in the inbox.
    if recipient == ORCH and kind in PUSH_KINDS and record_path(sender).is_file() and load(sender).get("orch_pane"):
        text = f"Message from {sender} ({kind}): run `nakama inbox` and act on it."
        pushed = run(["herdr", "agent", "prompt", load(sender)["orch_pane"], text], check=False).returncode == 0
    # herdr hands a prompt to a working agent too (probed on pi): the pointer reaches it mid-task.
    if recipient != ORCH and (agent_status(recipient) if live_status is None else live_status) is not None:
        rel = dest.relative_to(load(recipient)["worktree"])
        text = f"Message from {sender} ({kind}): read {rel} and act on it. It overrides task.md where they conflict."
        pushed = run(["herdr", "agent", "prompt", recipient, text], check=False).returncode == 0
    return {"to": recipient, "from": sender, "kind": kind, "status": "sent", "file": str(dest), "pushed": pushed}


def cmd_send(a):
    sender = os.environ.get("NAKAMA_AGENT", ORCH)
    if a.id is not None and not SEND_ID_RE.fullmatch(a.id):
        emit({"error": "--id must contain 1-64 letters, numbers, underscores, or hyphens"}, 2)
    src = Path(a.file)
    if a.to == "@all":
        if sender != ORCH:
            emit({"error": "only the orchestrator may send to @all"}, 2)
        if not src.is_file():
            emit({"error": f"{src} does not exist"}, 2)
        recipients = []
        for rec in records():
            name = rec["name"]
            if name in (sender, ORCH) or record_session(rec) != session_key(current_session()):
                continue
            state = agent_status(name)
            if state is not None:
                recipients.append((name, state))
        results = [send_one(sender, name, a.kind, src, a.id, state)
                   for name, state in recipients]
        emit({"to": "@all", "from": sender, "kind": a.kind,
              "status": "sent" if results else "no_recipients", "results": results})
    result = send_one(sender, a.to, a.kind, src, a.id)
    emit(result)


def cmd_inbox(a):
    me = a.name or os.environ.get("NAKAMA_AGENT", ORCH)
    messages = []
    for f in unread(me):
        _, sender, kind, _ = f.name.split(".")
        messages.append({"from": sender, "kind": kind, "file": str(f), "text": f.read_text()})
        if not a.peek:
            f.rename(f.with_suffix(".read"))
    emit({"name": me, "messages": messages})


def cmd_extend(a):
    rec = load(a.name)
    if rec["budget_min"] + rec["extended_min"] + a.minutes > MAX_BUDGET_MIN:
        emit({"name": rec["name"], "status": "refused", "budget_min": rec["budget_min"],
              "extended_min": rec["extended_min"]})
    rec["extended_min"] += a.minutes
    save(rec)
    emit({"name": rec["name"], "status": "extended", "budget_min": rec["budget_min"],
          "extended_min": rec["extended_min"]})


def cmd_pause(a):
    require_herdr()
    if (a.all and a.name) or (not a.all and not a.name):
        emit({"error": "provide exactly one of a worker name or --all"}, 2)
    if a.all:
        selected = [rec for rec in open_records()
                    if record_session(rec) == session_key(current_session())]
    else:
        rec = load(a.name)
        if rec["mode"] == "read":
            emit({"error": f"{rec['name']} is read-only and cannot be paused"}, 2)
        if rec["closed"]:
            emit({"error": f"{rec['name']} is already closed"}, 2)
        if not agent_dir(rec).is_dir():
            emit({"error": f"{rec['name']}: worktree {rec['worktree']} does not exist"}, 2)
        selected = [rec]

    results = {}
    pending = []
    unreachable = []
    stopped = False
    for rec in selected:
        if rec["mode"] == "read":
            # A read worker holds no uncommitted work: --all stops it instead of pausing it.
            run(["herdr", "agent", "send-keys", rec["name"], "ctrl+c", "ctrl+c"], check=False)
            close_worker_surface(rec)
            # Bank the time spent, so relaunching it does not hand out a fresh budget.
            patch_record(rec["name"], closed=True, spent_min=spent_minutes(rec))
            stopped = True
            results[rec["name"]] = {"name": rec["name"], "status": "stopped", "reason": "read_only"}
            continue
        if not agent_dir(rec).is_dir():
            results[rec["name"]] = {"name": rec["name"], "status": "skipped", "reason": "no_worktree"}
            continue
        if not rec.get("prompted_at"):
            # A worker that never got a task has nothing worth a Resume note.
            results[rec["name"]] = {"name": rec["name"], "status": "skipped", "reason": "not_prompted"}
            continue
        state = agent_status(rec["name"])
        if state in ("idle", "done", None) and fresh_result(rec)[0] is not None:
            results[rec["name"]] = {"name": rec["name"], "status": "skipped", "reason": "settled"}
            continue
        pause_file = agent_dir(rec) / "pause.md"
        pause_file.write_text(
            "Pause now. Do not commit and do not stash: leave your changes in the worktree.\n"
            "Write result.md next to your task file with Status: partial, Next: retry, a Steps: k/N line if the task "
            "has ## Steps, and a ## Resume section: what was in flight, the exact next action, and the "
            "uncommitted files and their state. Then stop.\n")
        sent_at = time.time()
        sent = send_one(ORCH, rec["name"], "info", pause_file, None)
        patch_record(rec["name"], pause_sent_at=sent_at)
        if sent.get("pushed"):
            pending.append((rec, sent_at))
        else:
            # No live agent will read the note: waiting on it would only burn the timeout.
            unreachable.append((rec, sent_at))

    had_recipients = bool(pending or unreachable or stopped)
    deadline = time.time() + a.timeout
    noted = {}
    interrupted = False
    try:
        while pending:
            for rec, sent_at in pending:
                result = agent_dir(rec) / "result.md"
                if (result.is_file() and result.stat().st_mtime > sent_at
                        and agent_status(rec["name"]) in ("idle", "done", None)):
                    _, result_status, _ = parse_result_status(result.read_text())
                    noted[rec["name"]] = result_status
            pending = [(rec, sent_at) for rec, sent_at in pending if rec["name"] not in noted]
            remaining = deadline - time.time()
            if not pending or remaining <= 0:
                break
            time.sleep(min(max(POLL_SEC, 0.01), remaining))
    except KeyboardInterrupt:
        # Stop waiting, but finish the job: noted workers park, the rest are forced as on a timeout.
        interrupted = True

    for rec in selected:
        if rec["name"] in results:
            continue
        was_noted = rec["name"] in noted
        result_status = noted.get(rec["name"])
        dirty = worktree_dirty(rec)
        if result_status and result_status not in ("partial", "needs_input") and not dirty:
            close_worker_surface(rec)
            patch_record(rec["name"], closed=True, paused=False, paused_forced=False)
            results[rec["name"]] = {
                "name": rec["name"], "status": "finished", "result_status": result_status,
                "steps": steps_info(rec), "dirty": dirty,
            }
            continue
        if was_noted:
            close_worker_surface(rec)
        else:
            stop_worker(rec)
        # Resume re-arms prompted_at, so the time already spent is banked here or it is lost.
        patch_record(rec["name"], closed=True, paused=True, paused_forced=not was_noted,
                     spent_min=spent_minutes(rec))
        results[rec["name"]] = {
            "name": rec["name"], "status": "paused" if was_noted else "paused_forced",
            "steps": steps_info(rec), "dirty": dirty,
        }
    ordered = [results[rec["name"]] for rec in selected]
    extra = {"interrupted": True} if interrupted else {}
    if a.all:
        emit({"status": "paused" if had_recipients else "no_recipients", "results": ordered, **extra})
    emit({**ordered[0], **extra})


def cmd_teardown(a):
    if a.force and not a.remove_worktree:
        emit({"error": "--force requires --remove-worktree"}, 2)
    rec = load(a.name)
    if a.remove_worktree and rec.get("paused") and not a.force:
        emit({"error": f"{rec['name']} is paused: its worktree holds uncommitted work; "
                       "resume it, or pass --force to discard"}, 2)
    run(["herdr", "agent", "send-keys", rec["name"], "ctrl+c", "ctrl+c"], check=False)
    close_worker_surface(rec)
    removed = False
    reason = None
    forced = False
    if a.remove_worktree:
        if rec["branch"]:
            cmd = ["wt", "remove", rec["branch"], "--yes"]
            if a.force:
                cmd.append("--force")
                forced = True
            result = run(cmd, check=False)
            removed = result.returncode == 0
            if not removed:
                reason = (result.stderr + result.stdout)[-300:].strip()
        else:
            reason = "no worktree owned by this agent"
    changes = {"closed": True}
    if removed:
        changes.update(paused=False, paused_forced=False, pause_sent_at=None)
    patch_record(rec["name"], **changes)
    out = {"name": rec["name"], "status": "closed", "worktree_removed": removed}
    if reason is not None:
        out["reason"] = reason
    if forced:
        out["forced"] = True
    emit(out)


def open_records():
    return [r for r in records() if not r["closed"]]


def cmd_list(a):
    selected = open_records()
    if not a.all:
        selected = [r for r in selected if record_session(r) == session_key(current_session())]
    emit({"agents": [{"name": r["name"], "role": r["role"], "kind": r["kind"], "worktree": r["worktree"],
                      "rounds": r["rounds"], "state": agent_status(r["name"])} for r in selected]})


def cmd_sweep(a):
    require_herdr()
    all_open = open_records()
    recs = all_open if a.all else [r for r in all_open
                                   if record_session(r) == session_key(current_session())]
    known = {r["name"] for r in all_open}
    metas = all_roles()
    # A custom --name matches no pattern; a record (open or closed) is what marks an agent as ours.
    recorded = {r["name"] for r in records()}
    stray = [n for n in live_names() if n not in known and (is_nakama_name(n, metas) or n in recorded)]
    listed = parse_external_json(
        run(["wt", "list", "--format", "json"]).stdout, "wt list", {"items": list})
    trees = find_key(listed, "items")
    branches = [t["branch"] for t in trees
                if isinstance(t.get("branch"), str) and t["branch"].startswith("agent/")]
    paused = [r for r in records() if r.get("paused") and Path(r["worktree"]).is_dir()]
    if not a.all:
        paused = [r for r in paused if record_session(r) == session_key(current_session())]
    emit({"open_records": [{"name": r["name"], "state": agent_status(r["name"])} for r in recs],
          "stray_agents": stray, "agent_worktrees": branches,
          "paused_workers": [{"name": r["name"], "worktree": r["worktree"]} for r in paused]})


def cmd_session_start(a):
    require_herdr()
    if not SESSION_NAME_RE.fullmatch(a.name):
        emit({"error": f"session name must be letters, numbers, underscores or hyphens; "
                        f"try {session_key(a.name)}"}, 2)
    if SESSION_PANE_KEY_RE.fullmatch(a.name):
        emit({"error": f"session name {a.name} looks like a herdr pane key; pick another name"}, 2)
    about = a.about or ""
    if not about.strip():
        emit({"error": "--about is required: one line describing the session"}, 2)
    if "\n" in about or "\r" in about:
        emit({"error": "--about must be a single line"}, 2)
    if len(about) > SESSION_ABOUT_MAX:
        emit({"error": f"--about must be at most {SESSION_ABOUT_MAX} characters"}, 2)
    # Directories, not readable metas: a case-insensitive filesystem would collide, and an
    # unreadable meta.json must not make its session invisible to this check.
    for key in session_keys():
        if key.casefold() == a.name.casefold():
            existing = session_meta(key)
            if existing is None:
                emit({"error": f"session {key} already exists but its meta.json is unreadable; "
                                f"remove {session_dir(key)} or pick another name"}, 2)
            owner = existing.get("owner_pane")
            emit({"error": f"session {key} already exists", "session": key,
                  "about": existing.get("about"), "pane": owner,
                  "pane_alive": owner is not None and agent_status(owner) is not None,
                  "resume_with": resume_command(existing.get("agent"))}, 2)
    pane = os.environ.get("HERDR_PANE_ID")
    if not pane:
        emit({"error": "no HERDR_PANE_ID: session start must run inside a herdr pane"}, 2)
    terminal = pane_terminal(pane)
    agent = pane_agent_session(pane)
    for key, meta in sessions_on_disk().items():
        if session_owned_by_pane(meta, pane, terminal):
            emit({"error": f"this pane already owns session {key} ({meta.get('about')}); "
                  "use it or start in another pane",
                  "session": key, "about": meta.get("about"), "pane": pane}, 2)
    claims = STATE_DIR / "sessions" / ".by-pane"
    claims.mkdir(parents=True, exist_ok=True)
    claim = claims / session_key(pane)
    lock_fd = os.open(claims / ".lock", os.O_CREAT | os.O_RDWR, 0o644)
    ours = created = False
    rebound_records = []
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        try:
            try:
                owned = claim.read_bytes().decode("ascii", errors="replace").strip()
            except FileNotFoundError:
                owned = ""
            meta = session_meta(owned) if SESSION_NAME_RE.fullmatch(owned) else None
            if session_owned_by_pane(meta, pane, terminal):
                emit({"error": f"this pane already owns session {owned}; use it or start in another pane",
                      "session": owned, "about": meta.get("about"), "pane": pane}, 2)
            owner_bytes = a.name.encode("ascii")
            fd = os.open(claim, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
            ours = True
            try:
                if os.write(fd, owner_bytes) != len(owner_bytes):
                    raise OSError("short write to pane claim")
            finally:
                os.close(fd)
            try:
                session_dir(a.name).mkdir()
                created = True
            except FileExistsError:
                emit({"error": f"session {a.name} already exists"}, 2)
            now = time.time()
            save_session_meta({"name": a.name, "about": about, "owner_pane": pane,
                               "owner_terminal": terminal, "created": now, "last_seen": now,
                               "adoptions": [], "agent": agent})
        finally:
            fcntl.flock(lock_fd, fcntl.LOCK_UN)
        # Naming a run after it started must not hide its own workers from it.
        # shortcut: failed starts are cleaned up only after every rebind restores its prior session.
        # Incomplete rollback retains its session and claim. Case variants can race across panes
        # on case-sensitive filesystems until Task 7 canonicalizes names in session rm/rename.
        rebound = 0
        for rec in open_records():
            if record_session(rec) == session_key(pane):
                rebound_records.append((rec["name"], rec.get("session")))
                patch_record(rec["name"], session=a.name)
                rebound += 1
    except BaseException as start_error:
        rollback_errors = []
        for name, previous_session in reversed(rebound_records):
            try:
                patch_record(name, session=previous_session)
            except BaseException as rollback_error:
                # BaseException too: patch_record's load() emits (SystemExit) if a record vanished.
                rollback_errors.append((name, rollback_error))
        if rollback_errors:
            # JSON contract: this failure needs manual recovery, so no traceback.
            details = "; ".join(f"{name}: {error}" for name, error in rollback_errors)
            emit({"error": f"session start failed ({start_error}); rollback incomplete ({details}); "
                            f"retained {session_dir(a.name)} and pane claim {claim}",
                  "session": a.name, "dir": str(session_dir(a.name)), "claim": str(claim)}, 1)
        if created or ours:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            try:
                if created:
                    shutil.rmtree(session_dir(a.name), ignore_errors=True)
                if ours:
                    try:
                        owned = claim.read_bytes().decode("ascii", errors="replace").strip()
                    except FileNotFoundError:
                        owned = None
                    if owned == a.name:
                        claim.unlink(missing_ok=True)
            finally:
                fcntl.flock(lock_fd, fcntl.LOCK_UN)
        raise
    finally:
        os.close(lock_fd)
    emit({"name": a.name, "about": about, "dir": str(session_dir(a.name)),
          "export": f"export NAKAMA_SESSION={a.name}", "rebound": rebound,
          "resume_with": resume_command(agent)})


def cmd_session_ls(a):
    require_herdr()
    now = time.time()
    by_key = {}
    for rec in readable_records():
        by_key.setdefault(record_session(rec), []).append(rec)

    def record_time(rec):
        try:
            return record_path(rec["name"]).stat().st_mtime
        except (OSError, KeyError):
            return None

    def newest(group):
        return max(group, key=lambda rec: record_time(rec) or 0)

    def record_times(group):
        return [t for t in (record_time(rec) for rec in group) if t is not None]

    def notes_info(key):
        try:
            st = (session_dir(key) / "notes.md").stat()
        except OSError:
            return {"bytes": 0, "age_minutes": None}, None
        return {"bytes": st.st_size, "age_minutes": round((now - st.st_mtime) / 60, 1)}, st.st_mtime

    def inbox_unread(key):
        return sum(1 for _ in inbox_dir(ORCH, key).glob("*.md"))

    def worker_counts(group):
        return {"open": sum(1 for rec in group if not rec.get("closed")), "total": len(group)}

    named = sessions_on_disk()
    rows = []
    for key, meta in named.items():
        try:
            meta_time = (session_dir(key) / "meta.json").stat().st_mtime
        except OSError:
            continue  # a failed session start can remove it after sessions_on_disk() read it
        group = by_key.get(key, [])
        notes, notes_time = notes_info(key)
        times = [meta_time, notes_time, *record_times(group)]
        pane = meta.get("owner_pane")
        alive, pane_reused = session_liveness(meta, pane_agent(pane))
        token = meta.get("agent")
        workers = worker_counts(group)
        rows.append({"name": meta.get("name"), "about": meta.get("about"),
                     "last_seen": max(t for t in times if t is not None),
                     "created": meta.get("created"), "pane": pane,
                     "alive": alive, "pane_reused": pane_reused,
                     "kind": token.get("agent") if isinstance(token, dict) else None,
                     "resume_with": resume_command(token), "workers": workers, "notes": notes,
                     "inbox_unread": inbox_unread(key), "legacy": False,
                     "stale": not alive and workers["open"] == 0})

    unnamed = []
    for key, group in by_key.items():
        workers = worker_counts(group)
        times = record_times(group)
        if key in named or workers["open"] == 0 or not times:
            continue
        unnamed.append({"session": key, "pane": newest(group).get("orch_pane"),
                        "workers_open": workers["open"], "last_seen": max(times)})
    unnamed.sort(key=lambda row: row["last_seen"], reverse=True)

    if a.legacy:
        for key, group in by_key.items():
            if key in named:
                continue
            rec = newest(group)
            pane = rec.get("orch_pane")
            alive = pane_agent(pane) is not None
            workers = worker_counts(group)
            notes, _ = notes_info(key)
            rows.append({"name": key, "about": None,
                         "last_seen": max(record_times(group), default=None),
                         "created": None, "pane": pane, "alive": alive, "pane_reused": False,
                         "kind": None, "resume_with": None, "workers": workers, "notes": notes,
                         "inbox_unread": inbox_unread(key), "legacy": True,
                         "stale": not alive and workers["open"] == 0, "cwd": rec.get("worktree")})

    # Tolerate a row whose record files all vanished: sort it last.
    rows.sort(key=lambda row: (row["last_seen"] is not None, row["last_seen"] or 0), reverse=True)
    emit({"sessions": rows, "unnamed": unnamed})


def cmd_takeover(a):
    require_herdr()
    if not SESSION_NAME_RE.fullmatch(a.name):
        emit({"error": "session name must be letters, numbers, underscores or hyphens"}, 2)
    here = os.environ.get("HERDR_PANE_ID")
    if not here:
        emit({"error": "no HERDR_PANE_ID: takeover must run inside a herdr pane"}, 2)
    # Directory names decide, not session_meta(name): a case-insensitive filesystem would open a twin.
    keys = session_keys()
    if a.name in keys:
        key = a.name
    else:
        variant = next((k for k in keys if k.casefold() == a.name.casefold()), None)
        if variant is not None:
            emit({"error": f"no session {a.name}; did you mean {variant}?",
                  "did_you_mean": variant}, 2)
        emit({"error": f"no session {a.name}; run nakama session ls"}, 2)
    if session_meta(key) is None:
        emit({"error": f"session {key} has an unreadable meta.json"}, 2)
    # Both before the lock: they call herdr, which must not run while others wait for the claims.
    terminal = pane_terminal(here)
    here_token = pane_agent_session(here)
    repointed = 0
    skipped = []
    try:
        # The repoint runs under the lock too: two takeovers must never interleave meta and records.
        with pane_claim_lock() as claims:
            meta = session_meta(key)
            if meta is None:
                emit({"error": f"session {key} has an unreadable meta.json"}, 2)
            old = meta.get("owner_pane")
            for other, other_meta in sessions_on_disk().items():
                if other != key and session_owned_by_pane(other_meta, here, terminal):
                    emit({"error": f"this pane already owns session {other} "
                                   f"({other_meta.get('about')}); take over from another pane",
                          "session": other}, 2)
            already_owner = session_owned_by_pane(meta, here, terminal)
            if not already_owner:
                # Meta first: a crash after it still leaves the session here, and a re-run finishes b-c.
                adoptions = meta.get("adoptions")
                now = time.time()
                save_session_meta({**meta, "name": key, "owner_pane": here,
                                   "owner_terminal": terminal, "last_seen": now,
                                   "adoptions": (adoptions if isinstance(adoptions, list) else [])
                                   + [{"pane": here, "from": old, "at": now, "agent": meta.get("agent")}]})
            # b and c run on both paths: a crash after the meta save must be repaired by a re-run.
            claim = claims / session_key(here)
            if claim_text(claim) != key:
                owner_bytes = key.encode("ascii")
                fd = os.open(claim, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
                try:
                    if os.write(fd, owner_bytes) != len(owner_bytes):
                        raise OSError("short write to pane claim")
                finally:
                    os.close(fd)
            # c: once meta names us, any other pane still claiming this session is stale.
            for path in claims.iterdir():
                if not path.name.startswith(".") and path != claim and claim_text(path) == key:
                    path.unlink(missing_ok=True)
            # On both paths: a re-run after a crash between the meta write and here repoints the rest.
            for rec in readable_records():
                if not rec.get("session") or record_session(rec) != key or rec.get("orch_pane") == here:
                    continue
                try:
                    rec2 = json.loads(record_path(rec["name"]).read_text())
                except (OSError, ValueError):
                    skipped.append(rec["name"])
                    continue
                if not isinstance(rec2, dict):
                    skipped.append(rec["name"])
                    continue
                rec2["orch_pane"] = here
                save(rec2)
                repointed += 1
    except OSError as exc:
        emit({"error": f"takeover failed: {exc}", "repointed": repointed}, 1)
    # meta still holds the pre-save token: the adoption entry copies it, the next launch replaces it.
    old_agent = pane_agent(old) if old else None
    alive, _ = session_liveness(meta, old_agent)
    maybe_alive = alive and old != here
    token = meta.get("agent")
    transcript = None
    if isinstance(token, dict):
        transcript = {"agent": token.get("agent"), "kind": token.get("kind"),
                      "value": token.get("value"), "resume_with": resume_command(token),
                      "cross_kind": (None if here_token is None
                                     else here_token["agent"] != token.get("agent"))}
    warnings = []
    if maybe_alive:
        warnings.append(f"old_orchestrator_surface_may_be_alive ({old})")
    env_session = os.environ.get("NAKAMA_SESSION")
    if env_session and session_key(env_session) != key:
        warnings.append(f"nakama_session_env_points_elsewhere ({env_session})")
    if skipped:
        warnings.append("skipped_records")
    emit({"name": key, "about": meta.get("about"), "already_owner": already_owner,
          "previous_pane": old, "export": f"export NAKAMA_SESSION={key}",
          "repointed": repointed, "skipped": skipped, "transcript": transcript,
          "orchestrator": {"pane": old, "maybe_alive": maybe_alive,
                           "close_with": f"herdr pane close {old}" if maybe_alive else None},
          "warnings": warnings, "next": "nakama brief"})


def cmd_session_about(a):
    require_herdr()
    key = session_key(current_session())
    text = a.text
    if not text.strip():
        emit({"error": "about is required: one line describing the session"}, 2)
    if "\n" in text or "\r" in text:
        emit({"error": "about must be a single line"}, 2)
    if len(text) > SESSION_ABOUT_MAX:
        emit({"error": f"about must be at most {SESSION_ABOUT_MAX} characters"}, 2)
    previous = None
    try:
        # Same lock as takeover: a concurrent adoption must not resurrect the old description.
        with pane_claim_lock():
            meta = session_meta(key)
            if meta is None:
                if session_dir(key).is_dir():
                    emit({"error": f"session {key} has an unreadable meta.json"}, 2)
                emit({"error": f"session {key} is not named; run: nakama session start <name> "
                               f"--about \"...\""}, 2)
            previous = meta.get("about")
            save_session_meta({**meta, "name": key, "about": text,
                               "last_seen": time.time()})
    except OSError as exc:
        emit({"error": f"session about failed: {exc}"}, 1)
    emit({"name": key, "about": text, "previous": previous})


def worker_mail(rec):
    box = agent_dir(rec) / "inbox"
    files = sorted(box.glob("*.md")) if box.is_dir() else []
    # File names are <ts>.<sender>.<kind>.md; anything else counts but names no kind.
    kinds = {f.name.split(".")[2] for f in files if len(f.name.split(".")) == 4}
    return {"unread": len(files), "kinds": sorted(kinds)}


def cmd_brief(a):
    """Read-only: no record, meta, mail or directory is written here."""
    require_herdr()
    session, source = current_session_with_source()
    key = session_key(session)
    meta = session_meta(key)
    here = os.environ.get("HERDR_PANE_ID")
    now = time.time()

    notes_path = session_dir(key) / "notes.md"
    try:
        notes_stat = notes_path.stat()
    except OSError:
        notes_stat = None
    notes = {"path": str(notes_path), "exists": notes_stat is not None,
             "age_minutes": round((now - notes_stat.st_mtime) / 60, 1) if notes_stat else None}

    orchestrator = None
    if meta is not None:
        pane = meta.get("owner_pane")
        agent = pane_agent(pane)
        alive, _ = session_liveness(meta, agent)
        orchestrator = {"pane": pane, "status": (agent or {}).get("agent_status"),
                        "maybe_alive": alive and pane != here}

    token = meta.get("agent") if meta is not None else None
    transcript = None
    if isinstance(token, dict):
        here_token = pane_agent_session(here)
        transcript = {"agent": token.get("agent"), "kind": token.get("kind"),
                      "value": token.get("value"), "resume_with": resume_command(token),
                      "cross_kind": (None if here_token is None
                                     else here_token["agent"] != token.get("agent"))}

    workers = []
    for rec in readable_records():
        if record_session(rec) != key or (rec.get("closed") and not a.closed):
            continue
        state = None if rec.get("closed") else (pane_agent(rec["name"]) or {}).get("agent_status")
        row = {"name": rec.get("name"), "role": rec.get("role"), "kind": rec.get("kind"),
               "worktree": rec.get("worktree"), "rounds": rec.get("rounds"), "state": state,
               "paused": bool(rec.get("paused")), "session": record_session(rec)}
        try:
            status, next_hop, _ = fresh_result(rec)
            row["result"] = None if status is None else {
                "status": status, "next": next_hop, "steps": steps_info(rec)}
            row["worktree_dirty"] = worktree_dirty(rec) if rec.get("worktree") else False
            row["mail"] = worker_mail(rec)
        except (OSError, ValueError, KeyError, TypeError) as exc:
            # One broken record must never abort the bearings.
            row.update(result=None, worktree_dirty=False, mail={"unread": 0, "kinds": []},
                       error=str(exc))
        workers.append(row)
    workers.sort(key=lambda row: row["name"])

    box = inbox_dir(ORCH, key)
    unread_mail = sorted(box.glob("*.md")) if box.is_dir() else []

    warnings = []
    if meta is None:
        warnings.append("unnamed_session: run 'nakama session start <name> --about \"<one line>\"'")
    if orchestrator and orchestrator["maybe_alive"]:
        warnings.append(f"old_orchestrator_surface_may_be_alive ({orchestrator['pane']})")
    if not notes["exists"]:
        warnings.append("no_handoff_notes")

    emit({"session": {"name": key, "about": ((meta or {}).get("about") or None),
                      "source": source,
                      "adopt": f"export NAKAMA_SESSION={key}" if source == "pane" else None},
          "orchestrator": orchestrator, "transcript": transcript, "notes": notes,
          "workers": workers,
          "unread_orchestrator_mail": {"count": len(unread_mail),
                                       "files": [str(p) for p in unread_mail]},
          "warnings": warnings})


def cmd_note(a):
    """Append one line to the session's handoff notes; existing bytes are never rewritten."""
    require_herdr()
    key = session_key(current_session())
    if session_meta(key) is None:
        emit({"error": f"session {key} not named; run: nakama session start <name> --about \"<one line>\""}, 2)
    text = digest_text(a.text).strip()
    if not text:
        emit({"error": "note text is empty"}, 2)
    if "\n" in text or "\r" in text:
        emit({"error": "note text must be one line"}, 2)
    path = session_dir(key) / "notes.md"
    now = time.localtime()
    day, stamp = time.strftime("%Y-%m-%d", now), time.strftime("%H:%M", now)
    line = f"- {stamp} {text}"
    try:
        existing = path.read_bytes().decode("utf-8", errors="replace") if path.is_file() else ""
        # Only the last heading line counts, split on \n only: a note may hold U+2028,
        # which splitlines() would split. rstrip tolerates a hand-edited CRLF or trailing space.
        headings = [l.rstrip() for l in existing.split("\n") if l.startswith("## ")]
        heading_added = not headings or headings[-1] != f"## {day}"
        chunk = ""
        if existing and not existing.endswith("\n"):
            chunk += "\n"
        if heading_added:
            chunk += ("\n" if existing else "") + f"## {day}\n\n"
        data = (chunk + line + "\n").encode("utf-8")
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        try:
            while data:
                data = data[os.write(fd, data):]
        finally:
            os.close(fd)
    except OSError as e:
        emit({"error": f"cannot write notes {path}: {e}"}, 2)
    emit({"session": key, "path": str(path), "line": line, "heading_added": heading_added})


def digest_cut(text, limit):
    return text[:limit] + "…" if len(text) > limit else text


def digest_text(value):
    # A transcript may hold a lone UTF-16 surrogate; no later strict UTF-8 encode accepts it.
    return value.encode("utf-8", "replace").decode("utf-8")


def digest_result_text(content):
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "".join(part.get("text", "") for part in content
                       if isinstance(part, dict) and part.get("type") == "text"
                       and isinstance(part.get("text"), str))
    return ""


def digest_tool_call(name, args):
    return f"`{name}({digest_cut(json.dumps(args, ensure_ascii=False), 120)})`"


def digest_tool_result(content):
    return f"`result: {digest_cut(digest_result_text(content), 200)}`"


def digest_pi_message(line):
    ts = line.get("timestamp") if isinstance(line.get("timestamp"), str) else "?"
    if line.get("type") == "compaction":
        summary = line.get("summary")
        return ("summary", ts, [summary]) if isinstance(summary, str) else None
    if line.get("type") != "message":
        return None
    msg = line.get("message")
    if not isinstance(msg, dict):
        return None
    role, content = msg.get("role"), msg.get("content")
    if not isinstance(content, (str, list)):
        return None
    if role == "toolResult":
        name = msg.get("toolName") if isinstance(msg.get("toolName"), str) else "result"
        return ("tool", ts, [f"`{name}: {digest_cut(digest_result_text(content), 200)}`"])
    if role not in ("user", "assistant"):
        return None  # system and anything unknown
    blocks = []
    for part in content if isinstance(content, list) else [{"type": "text", "text": content}]:
        if not isinstance(part, dict):
            continue
        if part.get("type") == "text" and isinstance(part.get("text"), str):
            blocks.append(part["text"])
        elif part.get("type") == "image":
            blocks.append("[image]")
        elif part.get("type") == "toolCall" and isinstance(part.get("name"), str):
            blocks.append(digest_tool_call(part["name"], part.get("arguments")))
    return (role, ts, blocks) if blocks else None


def digest_claude_message(line):
    if line.get("isSidechain") is True or line.get("type") not in ("user", "assistant"):
        return None
    msg = line.get("message")
    if not isinstance(msg, dict):
        return None
    ts = line.get("timestamp") if isinstance(line.get("timestamp"), str) else "?"
    content = msg.get("content")
    if isinstance(content, str):
        return (line["type"], ts, [content]) if content else None
    if not isinstance(content, list):
        return None
    blocks, has_text = [], False
    for part in content:
        if not isinstance(part, dict):
            continue
        ptype = part.get("type")
        if ptype == "tool_result":
            blocks.append(digest_tool_result(part.get("content")))
        elif ptype == "text" and isinstance(part.get("text"), str):
            blocks.append(part["text"])
            has_text = True
        elif ptype == "image":
            blocks.append("[image]")
            has_text = True
        elif ptype == "tool_use" and isinstance(part.get("name"), str):
            blocks.append(digest_tool_call(part["name"], part.get("input")))
            has_text = True
    if not blocks:
        return None
    # A user line holding only tool results is the tool turn, not a prompt.
    return ("user" if has_text or line["type"] == "assistant" else "tool", ts, blocks)


def digest_body(role, blocks):
    body = "\n\n".join(blocks)
    if role not in ("assistant", "summary"):
        return body
    data = body.encode()
    return body if len(data) <= 1536 else data[:1536].decode("utf-8", "ignore") + " … [cut]"


def digest_head(key, transcript, agent, shown, matched, total, dropped, max_bytes):
    head = (f"# Digest: {key}\n\nTranscript: {digest_text(str(transcript))} ({agent})\n"
            f"Messages: {shown} of {matched} matched, {total} total")
    if dropped:
        head += f"\n… {dropped} older messages dropped to fit {max_bytes} bytes"
    return head


def digest_document(key, transcript, agent, rendered, matched, total, dropped, max_bytes):
    head = digest_head(key, transcript, agent, len(rendered), matched, total, dropped, max_bytes)
    return head + ("\n\n" + "\n\n".join(rendered) if rendered else "")


def digest_truncate(document, max_bytes):
    footer = f"\n… truncated at {max_bytes} bytes\n"
    prefix = document.encode()[:max_bytes - len(footer.encode())]
    cut = prefix.rfind(b"\n")
    if cut != -1:
        prefix = prefix[:cut]  # keep the last whole line, never half a heading
    return prefix.decode("utf-8", "ignore") + footer


def digest_write(path, document):
    tmp = path.with_name(f"{path.name}.{os.getpid()}.tmp")
    try:
        tmp.unlink(missing_ok=True)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "wb") as f:
            f.write(document.encode())
        os.replace(tmp, path)
    except OSError as e:
        emit({"error": f"cannot write digest {path}: {e}"}, 2)
    finally:
        try:
            tmp.unlink(missing_ok=True)
        except OSError:
            pass


def cmd_digest(a):
    require_herdr()
    if a.tail < 1:
        emit({"error": "--tail must be at least 1"}, 2)
    if a.max_bytes < 1024:
        emit({"error": "--max-bytes must be at least 1024"}, 2)
    try:
        pattern = re.compile(a.grep, re.I) if a.grep is not None else None
    except (re.error, OverflowError) as e:
        emit({"error": f"invalid --grep pattern: {e}"}, 2)

    key = session_key(current_session())
    meta = session_meta(key)
    if meta is None:
        emit({"error": f"session {key} is not named; run: nakama session start <name> --about \"...\""}, 2)
    token = meta.get("agent")
    if not isinstance(token, dict) or not isinstance(token.get("value"), str):
        emit({"error": f"no transcript recorded for session {key} (captured on `session start` and `launch`)"}, 2)
    agent = token.get("agent")
    if agent == "pi":
        if token.get("kind") != "path":
            emit({"error": f"pi transcript token has kind {token.get('kind')!r}, expected 'path'"}, 2)
        transcript = Path(token["value"])
    elif agent == "claude":
        if token.get("kind") != "id" or not re.fullmatch(r"[A-Za-z0-9-]+", token["value"]):
            emit({"error": "claude transcript token must have kind 'id' and a plain uuid value"}, 2)
        glob = f"{HOME}/.claude/projects/*/{token['value']}.jsonl"
        matches = sorted(HOME.glob(f".claude/projects/*/{token['value']}.jsonl"))
        if not matches:
            emit({"error": f"no Claude Code transcript found for {token['value']} (looked for {glob})"}, 2)
        transcript = matches[0]
    else:
        emit({"error": f"unsupported orchestrator agent {agent!r}"}, 2)

    try:
        data = transcript.read_bytes()
    except (OSError, ValueError) as e:
        emit({"error": f"cannot read transcript {transcript}: {e}"}, 2)
    normalise = digest_pi_message if agent == "pi" else digest_claude_message
    messages = []
    for raw in data.split(b"\n"):
        try:
            line = json.loads(raw.decode("utf-8"))
        except (ValueError, RecursionError):
            # A live transcript may end mid-write, even mid-character; a deeply nested
            # line overflows json.loads before it can be called malformed.
            continue
        if not isinstance(line, dict):
            continue
        entry = normalise(line)
        if entry is not None:
            role, ts, blocks = entry
            messages.append((role, digest_text(ts), [digest_text(block) for block in blocks]))

    total = len(messages)
    selected = messages
    if pattern is not None:
        selected = [m for m in selected if pattern.search("\n\n".join(m[2]))]
    matched = len(selected)
    selected = selected[-a.tail:]

    rendered = [f"### {role} · {ts}\n\n{digest_body(role, blocks)}" for role, ts, blocks in selected]
    sizes = [len(item.encode()) for item in rendered]
    shown, start, dropped = len(rendered), 0, 0
    body_bytes = sum(sizes) + 2 * (shown - 1) if shown else 0
    while shown > 1:
        head = digest_head(key, transcript, agent, shown, matched, total, dropped, a.max_bytes)
        if len(head.encode()) + 2 + body_bytes <= a.max_bytes:
            break
        body_bytes -= sizes[start] + 2
        start += 1
        shown -= 1
        dropped += 1
    document = digest_document(key, transcript, agent, rendered[start:], matched, total, dropped, a.max_bytes)
    truncated = False
    if len(document.encode()) > a.max_bytes:
        document = digest_truncate(document, a.max_bytes)
        truncated = True

    digest_path = session_dir(key) / "digest.md"
    out = {"session": key, "transcript": str(transcript), "agent": agent,
           "messages": shown, "matched": matched, "total": total,
           "bytes": len(document.encode()), "dropped": dropped, "truncated": truncated}
    if a.stdout:
        emit({**out, "path": None, "text": document})
    digest_write(digest_path, document)
    emit({**out, "path": str(digest_path)})


def cmd_session(a):
    {"start": cmd_session_start, "ls": cmd_session_ls,
     "about": cmd_session_about}[a.session_action](a)


def cmd_roles(a):
    emit({"roles": [{k: v for k, v in m.items() if k != "body"} for m in all_roles()]})


def global_ignore_file():
    configured = run(["git", "config", "--global", "core.excludesFile"], check=False).stdout.strip()
    if configured:
        return Path(os.path.expanduser(configured))
    return Path(os.environ.get("XDG_CONFIG_HOME") or str(HOME / ".config"), "git", "ignore")


def herdr_version():
    if not shutil.which("herdr"):
        return None
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", run(["herdr", "--version"], check=False).stdout)
    return tuple(int(x) for x in match.groups()) if match else None


def cmd_doctor(a):
    checks = []

    def check(name, ok, fix, level="error"):
        checks.append({"check": name, "ok": bool(ok), "level": level, "fix": None if ok else fix})

    version = herdr_version()
    check("herdr >= 0.9.3", version and version >= MIN_HERDR, "install or upgrade herdr: https://herdr.dev")
    check("inside herdr", os.environ.get("HERDR_ENV") == "1", "run nakama from a herdr pane", "warn")
    for tool in ("wt", "git"):
        check(f"{tool} on PATH", shutil.which(tool), f"install {tool}")
    check("pi or claude on PATH", shutil.which("pi") or shutil.which("claude"), "install pi and/or Claude Code")
    if shutil.which("pi"):
        check("herdr pi integration", (HOME / ".pi/agent/extensions/herdr-agent-state.ts").is_file(),
              "herdr integration install pi")
    if shutil.which("claude"):
        check("herdr claude integration", (HOME / ".claude/hooks/herdr-agent-state.sh").is_file(),
              "herdr integration install claude")
    check("nakama on PATH", shutil.which("nakama"),
          'add to your shell profile: export PATH="$HOME/.local/bin:$PATH"', "warn")
    # Ask git in a scratch repo so any spelling of the pattern counts and only global excludes do.
    with tempfile.TemporaryDirectory(prefix="nakama-doctor-") as probe:
        run(["git", "init", "-q"], cwd=probe, check=False)
        asked = run(["git", "check-ignore", "-q", "--no-index", ".agent/x"], cwd=probe, check=False)
    ignore = global_ignore_file()
    check(".agent/ globally git-ignored", asked.returncode == 0,
          f"mkdir -p {ignore.parent} && echo '.agent/' >> {ignore}")
    top = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if top.returncode == 0:
        check(".worktreeinclude in this repo", Path(top.stdout.strip(), ".worktreeinclude").is_file(),
              "nakama init <gitignored files that worktrees need>", "warn")
    emit({"ok": all(c["ok"] for c in checks if c["level"] == "error"), "version": VERSION, "checks": checks})


def cmd_init(a):
    top = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if top.returncode != 0:
        emit({"error": "not inside a git repository"}, 2)
    include = Path(top.stdout.strip(), ".worktreeinclude")
    lines = include.read_text().splitlines() if include.is_file() else []
    added = [p for p in a.patterns if p not in lines]
    if added:
        include.write_text("\n".join(lines + added) + "\n")
    exclude = Path(run(["git", "rev-parse", "--path-format=absolute", "--git-path", "info/exclude"]).stdout.strip())
    exclude.parent.mkdir(parents=True, exist_ok=True)
    current = exclude.read_text().splitlines() if exclude.is_file() else []
    if ".worktreeinclude" not in current:
        exclude.write_text("\n".join(current + [".worktreeinclude"]) + "\n")
    emit({"worktreeinclude": str(include), "patterns": lines + added, "added": added, "excluded_via": str(exclude)})


def main():
    p = argparse.ArgumentParser(
        prog="nakama",
        description="Run pi / Claude Code workers in herdr tabs, each in its own worktrunk worktree. "
                    "Every command prints one JSON object.",
        epilog="typical loop:\n"
               "  nakama launch builder fix-login        # → b1-fix-login\n"
               "  $EDITOR <dir>/task.md                  # format: skills/nakama/SKILL.md\n"
               "  nakama prompt b1-fix-login task.md\n"
               "  nakama wait b1-fix-login               # repeat while it says running\n"
               "  nakama teardown b1-fix-login\n\n"
               "run 'nakama <command> --help' for a command's options.",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"nakama {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    s = sub.add_parser("launch", help="start a worker in its own herdr tab (and worktree)",
                       description="Start a worker. Defaults come from roles/<role>.md "
                                   "(~/.config/nakama/roles/ overrides the bundled roles); flags override them.")
    s.add_argument("role", help="role name, e.g. builder, reviewer, researcher (see 'nakama roles')")
    s.add_argument("slug", help="short task label; the agent name becomes <prefix><n>-<slug>")
    s.add_argument("--kind", choices=["pi", "claude"], help="agent CLI (default: the role's kind)")
    s.add_argument("--name", help="explicit agent name instead of the generated one")
    s.add_argument("--model", help="model id for that CLI (default: the role's model, if the kind matches)")
    s.add_argument("--base", default="HEAD", help="git ref the new worktree branches from (default: HEAD)")
    s.add_argument("--budget", type=int, metavar="MIN", help="time budget in minutes (default: the role's budget)")
    s.add_argument("--layout", choices=["tab", "split"], default="tab",
                   help="tab: the agent's own herdr tab (default); split: a pane beside yours")
    s.add_argument("--direction", choices=["right", "down"], default="right", help="split direction for --layout split")
    where = s.add_mutually_exclusive_group()
    where.add_argument("--join", metavar="AGENT", help="work in that agent's worktree, e.g. a reviewer in the builder's worktree")
    where.add_argument("--no-worktree", action="store_true", help="work in the current checkout")

    s = sub.add_parser("resume", help="restart a worker on its existing worktree and re-prime it")
    s.add_argument("name", help="agent name")

    s = sub.add_parser("prompt", help="send a task or fix file to a worker",
                       description="Send 'Read .agent/<name>/<file> and do it. Write result.md with Status exactly one of succeeded, partial, failed, needs_input.' Returns busy while the agent is working.")
    s.add_argument("name", help="agent name")
    s.add_argument("file", help="task.md, or fix-N.md for a fix round (max 2)")
    s.add_argument("--answer", action="store_true", help="answer to needs_input; does not count as a round")

    s = sub.add_parser("wait", help="wait for a worker's result",
                       description="Return succeeded/partial/failed/needs_input/malformed (with a Status hint)/blocked/stalled/over_budget/message, "
                                   "or running when --timeout passes (call it again).")
    s.add_argument("name", help="agent name")
    s.add_argument("--timeout", type=float, default=280, metavar="SEC", help="seconds before returning running (default: 280)")

    s = sub.add_parser("send", help="message an agent, the orchestrator, or all live workers",
                       description="Drop a message file in the recipient's inbox. The orchestrator can use '@all' "
                                   "to reach every live worker in its session. Optional --id KEY makes retries idempotent for "
                                   "that sender and recipient. The orchestrator's nakama wait returns 'message'; "
                                   "a worker reads it with nakama inbox. Workers may only message the orchestrator "
                                   "unless their role has 'peers: true'.")
    s.add_argument("to", help=f"agent name, '{ORCH}', or '@all' (orchestrator only)")
    s.add_argument("kind", choices=MESSAGE_KINDS, help="done: finished; ask: need a judgement; answer; info; blocker")
    s.add_argument("file", help="markdown file holding the message")
    s.add_argument("--id", help="optional idempotency key (1-64 letters, numbers, underscores, or hyphens)")

    s = sub.add_parser("inbox", help="read and clear unread messages",
                       description="Print unread messages for you (default: $NAKAMA_AGENT, else the orchestrator) "
                                   "and mark them read.")
    s.add_argument("name", nargs="?", help="agent name (default: yourself)")
    s.add_argument("--peek", action="store_true", help="do not mark messages read")

    s = sub.add_parser("extend", help="add minutes to a worker's time budget (max 180 in total)")
    s.add_argument("name", help="agent name")
    s.add_argument("minutes", type=int, help="minutes to add")

    s = sub.add_parser(
        "pause", help="ask builders to stop now, write a Resume note and leave changes uncommitted; "
                      "closes their tab, keeps the worktree",
        description="Ask builders to stop now, write a Resume note and leave changes uncommitted; "
                    "closes their tab, keeps the worktree. Use --all for open workers in this session.")
    s.add_argument("name", nargs="?", help="worker name (omit when using --all)")
    s.add_argument("--all", action="store_true", help="pause open workers in this session")
    s.add_argument("--timeout", type=float, default=PAUSE_SEC, metavar="SEC",
                   help="seconds to wait for a Resume note (default: 300)")

    s = sub.add_parser("teardown", help="stop a worker and close its tab")
    s.add_argument("name", help="agent name")
    s.add_argument("--remove-worktree", action="store_true", help="also remove its worktree (the branch is kept)")
    s.add_argument("--force", action="store_true", help="force worktree removal; requires --remove-worktree")

    s = sub.add_parser("session", help="name this orchestration session so a later one can adopt it",
                       description="Name this orchestration session in one line and bind it to this herdr pane.")
    ss = s.add_subparsers(dest="session_action", required=True, metavar="<action>")
    st = ss.add_parser("start", help="create a named session in this pane",
                       description="Create a named session bound to this pane; print the export line to use it.")
    st.add_argument("name", help="session name: letters, numbers, underscores or hyphens")
    st.add_argument("--about", help=f"one line describing the session (max {SESSION_ABOUT_MAX} characters)")
    sl = ss.add_parser("ls", help="list named sessions: description, liveness, resume command, workers, unread mail",
                       description="List named sessions read-only: description, liveness, resume command, "
                                   "workers, notes and unread mail.")
    sl.add_argument("--legacy", action="store_true",
                    help="also list unnamed pane-id sessions and the default bucket")
    sa = ss.add_parser("about", help="replace this session's one-line description")
    sa.add_argument("text", help="one line")
    s = sub.add_parser("takeover", help="adopt a named session in this pane: rebind it, repoint "
                                        "its workers' pokes, print the resume command")
    s.add_argument("name", help="session name: letters, numbers, underscores or hyphens")
    s = sub.add_parser("brief", help="read-only bearings for adopting this session: orchestrator, "
                                     "transcript, notes, workers, unread mail")
    s.add_argument("--closed", action="store_true", help="include closed workers")
    s = sub.add_parser("note", help="append a timestamped line to this session's handoff notes (notes.md)")
    s.add_argument("text", help="one line; quote it")
    s = sub.add_parser("digest", help="render this session's orchestrator transcript into a "
                                     "bounded markdown digest for a handoff to another agent kind")
    s.add_argument("--tail", type=int, default=200, metavar="N",
                   help="keep only the last N messages (default: 200)")
    s.add_argument("--grep", metavar="PAT",
                   help="keep only messages whose full body matches this regex (case-insensitive)")
    s.add_argument("--max-bytes", type=int, default=204800, metavar="B",
                   help="cap the digest at B bytes, dropping oldest messages first (default: 204800)")
    s.add_argument("--stdout", action="store_true",
                   help="print the digest text instead of writing digest.md")
    s = sub.add_parser("list", help="list open workers and their herdr state")
    s.add_argument("--all", action="store_true", help="include workers from every session")
    s = sub.add_parser("sweep", help="list this session's open workers, orphaned workers and agent/* worktrees")
    s.add_argument("--all", action="store_true", help="include open worker records from every session")
    sub.add_parser("roles", help="list roles and the files they come from")
    sub.add_parser("doctor", help="check the setup and print fix commands")
    s = sub.add_parser("init", help="write this repo's .worktreeinclude, hidden from git",
                       description="Gitignored files new worktrees need (e.g. .env), copied in by 'wt step copy-ignored'.")
    s.add_argument("patterns", nargs="+", help="gitignore-style patterns")
    a = p.parse_args()
    {"launch": cmd_launch, "resume": cmd_resume, "prompt": cmd_prompt, "wait": cmd_wait, "send": cmd_send, "inbox": cmd_inbox, "extend": cmd_extend,
     "pause": cmd_pause, "teardown": cmd_teardown, "list": cmd_list, "sweep": cmd_sweep, "roles": cmd_roles,
     "doctor": cmd_doctor, "init": cmd_init, "session": cmd_session, "takeover": cmd_takeover, "brief": cmd_brief,
     "note": cmd_note,
     "digest": cmd_digest}[a.cmd](a)


if __name__ == "__main__":
    main()
