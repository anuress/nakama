#!/usr/bin/env python3
"""nakama: run pi / Claude Code workers in herdr panes. Usage: see ../skills/nakama/SKILL.md."""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "0.1.0"
REPO_DIR = Path(__file__).resolve().parent.parent
HOME = Path.home()
STATE_DIR = Path(os.environ.get("NAKAMA_STATE_DIR", str(HOME / ".local/state/nakama")))
GRACE_SEC = float(os.environ.get("NAKAMA_GRACE_SEC", "20"))
POLL_SEC = float(os.environ.get("NAKAMA_POLL_SEC", "2"))

# User roles override bundled roles with the same name.
USER_ROLES_DIR = Path(os.environ.get("NAKAMA_USER_ROLES_DIR", str(HOME / ".config/nakama/roles")))
BUNDLED_ROLES_DIR = Path(os.environ.get("NAKAMA_ROLES_DIR", str(REPO_DIR / "roles")))
MIN_HERDR = (0, 9, 3)

MAX_ROUNDS = 2
MAX_BUDGET_MIN = 180
SLUG_CHARS = set("abcdefghijklmnopqrstuvwxyz0123456789-")
NAME_RE = re.compile(r"^[a-z][a-z0-9_-]{0,31}$")
# Agent-side dialogs herdr does not classify as blocked (pi extensions such as a security scanner).
PROMPT_MARKERS = ("Allow execution?",)
CHECK_SEC = 30
STALL_SEC = 600
ORCH = "orchestrator"
PUSH_KINDS = ("done", "ask", "blocker")
MESSAGE_KINDS = ("done", "ask", "answer", "info", "blocker")
MAX_INBOX = 20
SEND_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
STATUS_RE = re.compile(r"^Status:\s*(succeeded|partial|failed|needs_input)\b", re.M)
NEXT_RE = re.compile(r"^Next:\s*(\S+)\s*$", re.M)
NEXT_HOPS = {"review", "merge", "none", "retry", "ask"}

# Set from the probe results (plan Tasks 1-3).
WT_PATH_KEY = "path"
PI_PERSONA_AS_TEXT = False
PI_READ_TOOLS = "read,bash,grep,find,ls,write"
# Always pass an explicit --permission-mode: a user default of auto mode overrides the allow list.
# Project-specific commands (build tools) belong in that repo's .claude/settings.local.json.
CLAUDE_FLAGS = {
    "write": ["--permission-mode", "acceptEdits", "--allowedTools", "Bash(git status:*)", "Bash(git diff:*)",
              "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)", "Bash(mkdir:*)",
              "Bash(nakama send:*)", "Bash(nakama inbox:*)"],
    "read": ["--permission-mode", "default", "--allowedTools", "Bash(git diff:*)", "Bash(git log:*)",
             "Bash(git show:*)", "Bash(git status:*)", "Bash(git grep:*)", "Bash(git ls-files:*)",
             "Edit(.agent/**)", "Bash(nakama send:*)", "Bash(nakama inbox:*)"],
}


def emit(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


def run(cmd, cwd=None, check=True):
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True)
    if check and p.returncode != 0:
        emit({"error": " ".join(cmd[:3]), "stderr": p.stderr.strip()[-500:]}, 1)
    return p


def find_key(obj, key):
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        obj = list(obj.values())
    if isinstance(obj, list):
        for item in obj:
            found = find_key(item, key)
            if found is not None:
                return found
    return None


def parse_external_json(stdout, command, expected):
    try:
        data = json.loads(stdout)
    except json.JSONDecodeError:
        emit({"error": f"{command} returned unexpected output", "stdout": stdout[:300]}, 1)
    for key, value_type in expected.items():
        value = find_key(data, key)
        if (not isinstance(value, value_type) or (isinstance(value, str) and not value)
                or (isinstance(value, list) and any(not isinstance(item, dict) for item in value))):
            emit({"error": f"{command} returned unexpected output", "stdout": stdout[:300]}, 1)
    return data


def common_body():
    path = next((d / "_common.md" for d in (USER_ROLES_DIR, BUNDLED_ROLES_DIR)
                 if (d / "_common.md").is_file()), None)
    return path.read_text().strip() if path else ""


def load_role(role):
    path = next((d / f"{role}.md" for d in (USER_ROLES_DIR, BUNDLED_ROLES_DIR)
                 if not role.startswith("_") and (d / f"{role}.md").is_file()), None)
    if path is None:
        emit({"error": f"unknown role {role}: no {role}.md in {USER_ROLES_DIR} or {BUNDLED_ROLES_DIR}"}, 2)
    text = path.read_text()
    meta, body = {}, text

    def unquote(value):
        return value[1:-1] if len(value) > 1 and value[0] == value[-1] and value[0] in "'\"" else value

    def scalar(value):
        value = value.strip()
        if value[:1] in "'\"" and value[:1] and (end := value.find(value[0], 1)) > 0:
            return value[1:end]
        return value.split("#")[0].strip()

    if text.startswith("---\n"):
        head, _, body = text[4:].partition("\n---\n")
        for line in head.splitlines():
            key, sep, value = line.partition(":")
            if sep:
                meta[key.strip()] = scalar(value)
    try:
        budget = int(meta.get("budget") or 20)
    except ValueError:
        emit({"error": f"role {role}: budget must be a whole number of minutes"}, 2)
    names = meta.get("names", "").strip()
    if names.startswith("[") and names.endswith("]"):
        names = names[1:-1]
    return {
        "role": role,
        "prefix": meta.get("prefix") or role[0],
        "kind": meta.get("kind") or "pi",
        "model": meta.get("model") or None,
        "mode": meta.get("mode") or "read",
        "budget": budget,
        "names": [unquote(n.strip()) for n in names.split(",") if n.strip()],
        "spawns": meta.get("spawns", "").lower() in ("true", "yes"),
        "peers": meta.get("peers", "").lower() in ("true", "yes"),
        "path": str(path),
        "body": "\n\n".join(part for part in (common_body(), body.lstrip()) if part),
    }


def all_roles():
    stems = {p.stem for d in (USER_ROLES_DIR, BUNDLED_ROLES_DIR) for p in d.glob("*.md")
             if not p.stem.startswith("_")}
    return [load_role(stem) for stem in sorted(stems)]


def pick_name(meta, slug, taken, explicit=None):
    if explicit:
        if not NAME_RE.match(explicit) or explicit in taken:
            emit({"error": f"name {explicit!r} is invalid or already in use"}, 2)
        return explicit
    clean = "".join(c if c in SLUG_CHARS else "-" for c in slug.lower())
    stem = meta["names"][0] if meta["names"] else meta["prefix"]
    first = 2 if meta["names"] else 1
    candidates = [f"{n}-{clean}" for n in meta["names"]]
    candidates += [f"{stem}{i}-{clean}" for i in range(first, 1000)]
    for candidate in candidates:
        candidate = candidate[:32]
        if NAME_RE.match(candidate) and candidate not in taken:
            return candidate
    emit({"error": f"no free name for role {meta['role']}"}, 2)


def is_nakama_name(name, metas):
    for meta in metas:
        if re.match(rf"^{re.escape(meta['prefix'])}[0-9]+-", name):
            return True
        if any(re.match(rf"^{re.escape(n)}[0-9]*-", name) for n in meta["names"]):
            return True
    return False


def worker_env(name):
    return {
        "NAKAMA_AGENT": name,
        "GIT_SSH_COMMAND": "false",
        "GH_CONFIG_DIR": tempfile.mkdtemp(prefix="nakama-gh-"),
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": "credential.helper",
        "GIT_CONFIG_VALUE_0": "",
    }


def require_herdr():
    if os.environ.get("HERDR_ENV") != "1":
        emit({"error": "not inside herdr (HERDR_ENV != 1)"}, 2)


def record_path(name):
    return STATE_DIR / f"{name}.json"


def load(name):
    path = record_path(name)
    if not path.is_file():
        emit({"error": f"no record for {name}"}, 2)
    return json.loads(path.read_text())


def save(rec):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    record_path(rec["name"]).write_text(json.dumps(rec, indent=2))


def records():
    return [json.loads(p.read_text()) for p in sorted(STATE_DIR.glob("*.json"))]


def agent_dir(rec):
    return Path(rec["worktree"], ".agent", rec["name"])


def live_names():
    data = parse_external_json(
        run(["herdr", "agent", "list"]).stdout, "herdr agent list", {"agents": list})
    return [a["name"] for a in find_key(data, "agents")
            if isinstance(a, dict) and isinstance(a.get("name"), str) and a["name"]]


def agent_status(name):
    p = run(["herdr", "agent", "get", name], check=False)
    if p.returncode != 0:
        return None
    data = parse_external_json(p.stdout, "herdr agent get", {"agent_status": str})
    return find_key(data, "agent_status")


def visible(name):
    return run(["herdr", "agent", "read", name, "--source", "visible"], check=False).stdout


def screen(name):
    # recent-unwrapped is refused while an agent is working; the visible screen always works.
    p = run(["herdr", "agent", "read", name, "--source", "recent-unwrapped", "--lines", "60"], check=False)
    return p.stdout if p.returncode == 0 else visible(name)


def fresh_result(rec):
    result = agent_dir(rec) / "result.md"
    if not rec.get("prompted_at") or not result.is_file() or result.stat().st_mtime <= rec["prompted_at"]:
        return None, None
    text = result.read_text()
    status_match = STATUS_RE.search(text)
    next_match = NEXT_RE.search(text)
    next_hop = next_match.group(1) if next_match and next_match.group(1) in NEXT_HOPS else None
    return (status_match.group(1) if status_match else "malformed"), next_hop


def over_budget(rec):
    elapsed_min = (time.time() - rec["prompted_at"]) / 60
    return elapsed_min > rec["budget_min"] + rec["extended_min"]


def agent_args(rec, meta):
    persona = agent_dir(rec) / "persona.md"
    persona.write_text(meta["body"])
    if rec["kind"] == "pi":
        args = ["--approve", "--append-system-prompt", meta["body"] if PI_PERSONA_AS_TEXT else str(persona)]
        if rec["mode"] == "read":
            args += ["--tools", PI_READ_TOOLS]
    else:
        args = ["--append-system-prompt-file", str(persona), *CLAUDE_FLAGS[rec["mode"]]]
    if rec.get("model"):
        args += ["--model", rec["model"]]
    return args


def check_parent_permission():
    parent = os.environ.get("NAKAMA_AGENT")
    if parent:
        parent_role = json.loads(record_path(parent).read_text())["role"] if record_path(parent).is_file() else None
        if not (parent_role and load_role(parent_role)["spawns"]):
            emit({"error": f"agent {parent} may not launch agents: its role needs 'spawns: true'"}, 2)


def close_worker_surface(rec):
    if rec.get("tab"):
        run(["herdr", "tab", "close", rec["tab"]], check=False)
    else:
        run(["herdr", "pane", "close", rec["pane"]], check=False)
    if rec.get("gh_config_dir"):
        # Only the dir recorded at launch is nakama's to delete.
        shutil.rmtree(rec["gh_config_dir"], ignore_errors=True)


def start_worker(rec, meta, layout="tab", direction="right"):
    # A tab per agent keeps the caller's pane full-size; the herdr sidebar lists every agent.
    # Target the caller's own workspace/pane: herdr's defaults follow focus, which may be elsewhere.
    if layout == "tab":
        workspace = os.environ.get("HERDR_WORKSPACE_ID")
        surface = ["herdr", "tab", "create", *(["--workspace", workspace] if workspace else []),
                   "--label", rec["name"], "--cwd", rec["worktree"], "--no-focus"]
    else:
        pane = os.environ.get("HERDR_PANE_ID")
        surface = ["herdr", "pane", "split", *(["--pane", pane] if pane else ["--current"]),
                   "--direction", direction, "--cwd", rec["worktree"], "--no-focus"]
    for key, value in worker_env(rec["name"]).items():
        surface += ["--env", f"{key}={value}"]
    expected = {"pane_id": str}
    if layout == "tab":
        expected["tab_id"] = str
    command = "herdr tab create" if layout == "tab" else "herdr pane split"
    created = parse_external_json(run(surface).stdout, command, expected)
    rec["pane"] = find_key(created, "pane_id")
    rec["tab"] = find_key(created, "tab_id") if layout == "tab" else None
    # The GH_CONFIG_DIR worker_env made: teardown removes exactly this one and nothing else.
    rec["gh_config_dir"] = next(v.split("=", 1)[1] for v in surface if v.startswith("GH_CONFIG_DIR="))
    save(rec)
    return run(["herdr", "agent", "start", rec["name"], "--kind", rec["kind"], "--pane", rec["pane"],
                "--timeout", "60000", "--", *agent_args(rec, meta)], check=False)


def launcher_orch_pane():
    """The orchestrator inbox is global: a worker launched by a worker inherits the root orchestrator's pane."""
    parent = os.environ.get("NAKAMA_AGENT")
    if parent and record_path(parent).is_file():
        return load(parent).get("orch_pane")
    return os.environ.get("HERDR_PANE_ID")


def cmd_launch(a):
    require_herdr()
    check_parent_permission()
    meta = load_role(a.role)
    if (a.kind or meta["kind"]) not in ("pi", "claude") or meta["mode"] not in CLAUDE_FLAGS:
        emit({"error": f"role {a.role}: kind must be pi|claude and mode read|write"}, 2)
    taken = set(live_names()) | {r["name"] for r in records()}
    name = pick_name(meta, a.slug, taken, a.name)
    branch = None
    if a.join:
        worktree = load(a.join)["worktree"]
    elif a.no_worktree:
        worktree = os.getcwd()
    else:
        branch = f"agent/{name}"
        out = run(["wt", "switch", "-c", branch, "--base", a.base, "--no-cd", "--yes", "--format", "json"]).stdout
        worktree = find_key(
            parse_external_json(out, "wt switch", {WT_PATH_KEY: str}), WT_PATH_KEY)
        run(["wt", "step", "copy-ignored", "--require-include"], cwd=worktree)
    rec = {
        "name": name, "role": a.role, "kind": a.kind or meta["kind"],
        "model": a.model or (meta["model"] if (a.kind or meta["kind"]) == meta["kind"] else None),
        "mode": meta["mode"], "pane": None, "tab": None, "layout": a.layout,
        "direction": a.direction, "worktree": worktree, "branch": branch,
        "budget_min": a.budget or meta["budget"], "extended_min": 0, "prompted_at": None,
        "nudged_at": None, "screen_sig": None, "screen_changed_at": None,
        "rounds": 0, "closed": False, "orch_pane": launcher_orch_pane(),
    }
    agent_dir(rec).mkdir(parents=True, exist_ok=True)
    started = start_worker(rec, meta, a.layout, a.direction)
    out = {"name": name, "pane": rec["pane"], "worktree": worktree, "branch": branch, "dir": str(agent_dir(rec))}
    if started.returncode != 0:
        emit({**out, "status": "blocked", "stderr": started.stderr.strip()[-300:], "screen": screen(name)})
    emit({**out, "status": "ready"})


def cmd_resume(a):
    require_herdr()
    check_parent_permission()
    rec = load(a.name)
    worktree = Path(rec["worktree"])
    task = agent_dir(rec) / "task.md"
    if not worktree.is_dir():
        emit({"error": f"worktree {worktree} does not exist"}, 2)
    if not task.is_file():
        emit({"error": f"{task} does not exist"}, 2)
    meta = load_role(rec["role"])
    if rec.get("kind") not in ("pi", "claude") or rec.get("mode") not in CLAUDE_FLAGS:
        emit({"error": f"record for {rec['name']} has invalid kind or mode"}, 2)
    state = agent_status(rec["name"]) if not rec.get("closed") else None
    if state is not None and rec.get("prompted_at") is not None:
        emit({"name": rec["name"], "status": "already_live"})

    layout = rec.get("layout") or ("tab" if rec.get("tab") else "split")
    if state is None:
        if not rec.get("closed"):
            close_worker_surface(rec)
        rec.update(closed=False, prompted_at=None, nudged_at=None, extended_min=0,
                   screen_sig=None, screen_changed_at=None)
        started = start_worker(rec, meta, layout, rec.get("direction", "right"))
        if started.returncode != 0:
            out = {"name": rec["name"], "pane": rec["pane"], "worktree": rec["worktree"]}
            emit({**out, "status": "blocked", "stderr": started.stderr.strip()[-300:], "screen": screen(rec["name"])})

    message = ("You are being resumed after a restart. Re-read "
               f".agent/{rec['name']}/task.md and every fix-*.md next to it, check `git log` and `git status` "
               "in this worktree to see what is already done, then continue and write result.md as required.")
    prompted_at = time.time()
    prompted = run(["herdr", "agent", "prompt", rec["name"], message], check=False)
    if prompted.returncode != 0:
        emit({"name": rec["name"], "status": "prompt_failed", "stderr": prompted.stderr.strip()[-300:]}, 1)
    rec.update(prompted_at=prompted_at, nudged_at=None, extended_min=0,
               screen_sig=None, screen_changed_at=None)
    save(rec)
    emit({"name": rec["name"], "status": "fresh_primed", "pane": rec["pane"],
          "worktree": rec["worktree"], "rounds": rec["rounds"]})


def cmd_prompt(a):
    rec = load(a.name)
    task = agent_dir(rec) / Path(a.file).name
    if not task.is_file():
        emit({"error": f"{task} does not exist"}, 2)
    if agent_status(rec["name"]) == "working":
        emit({"name": rec["name"], "status": "busy", "rounds": rec["rounds"]})
    if task.name.startswith("fix-") and not a.answer:
        if rec["rounds"] >= MAX_ROUNDS:
            emit({"name": rec["name"], "status": "round_limit", "rounds": rec["rounds"]})
        rec["rounds"] += 1
    rel = task.relative_to(rec["worktree"])
    prompted_at = time.time()
    run(["herdr", "agent", "prompt", rec["name"], f"Read {rel} and do it."])
    # Saved only once the prompt reached the agent: a failed prompt spends no round and no time.
    rec.update(prompted_at=prompted_at, nudged_at=None, extended_min=0,
               screen_sig=None, screen_changed_at=None)
    save(rec)
    emit({"name": rec["name"], "status": "prompted", "file": str(rel), "rounds": rec["rounds"]})


def cmd_wait(a):
    rec = load(a.name)
    if not rec.get("prompted_at"):
        emit({"error": f"{rec['name']} was never prompted"}, 2)
    deadline = time.time() + a.timeout
    stall_sec = float(os.environ.get("NAKAMA_STALL_SEC", str(STALL_SEC)))
    me = os.environ.get("NAKAMA_AGENT", ORCH)

    def done(status, **extra):
        emit({"name": rec["name"], "status": status, "rounds": rec["rounds"],
              "result": str(agent_dir(rec) / "result.md"), **extra})

    while True:
        state = agent_status(rec["name"])
        status, next_hop = fresh_result(rec)
        # A fresh result counts only once the agent has settled: it may still commit or rewrite it.
        if status and state in ("idle", "done", None):
            extra = {}
            # The result is the report: a done mail from this agent would only make the next wait return early.
            for f in unread(me):
                if f.name.split(".")[1:3] == [rec["name"], "done"]:
                    f.unlink()
            if next_hop:
                extra["next"] = next_hop
            if status == "succeeded" and not next_hop:
                extra["warnings"] = ["no_next_hop"]
            done(status, **extra)
        # Unread mail makes every wait return at once: read it with nakama inbox.
        if mail := unread(me):
            done("message", messages=[str(f) for f in mail])
        if state is None:
            done("failed", reason="agent or pane gone")
        if state == "blocked":
            done("blocked", screen=screen(rec["name"]))
        if over_budget(rec):
            done("over_budget", screen=screen(rec["name"]))
        if state == "working":
            current = visible(rec["name"])
            # Only the last 10 non-empty lines are live: code or a log higher up can quote a marker.
            tail = [line for line in current.splitlines() if line.strip()][-10:]
            if any(marker in line for line in tail for marker in PROMPT_MARKERS):
                done("blocked", screen=current)
            screen_sig = re.sub(r"[^A-Za-z]+", "", "\n".join(tail))
            now = time.time()
            if screen_sig != rec.get("screen_sig"):
                rec.update(screen_sig=screen_sig, screen_changed_at=now)
                save(rec)
            else:
                idle_seconds = now - rec.get("screen_changed_at", now)
                if idle_seconds >= stall_sec:
                    done("stalled", screen=current, idle_seconds=int(idle_seconds))
        settled = state in ("idle", "done")
        since = time.time() - max(rec["prompted_at"], rec["nudged_at"] or 0)
        if settled and since >= GRACE_SEC:
            if rec["nudged_at"]:
                done("failed", reason="no fresh result.md after one nudge")
            rec["nudged_at"] = time.time()
            save(rec)
            rel = agent_dir(rec).relative_to(rec["worktree"])
            run(["herdr", "agent", "prompt", rec["name"], f"Write {rel}/result.md as your task file requires."],
                check=False)
            continue
        remaining = deadline - time.time()
        if remaining <= 0:
            done("running")
        if not settled:
            ms = int(max(min(remaining, CHECK_SEC) * 1000, 3000))
            run(["herdr", "agent", "wait", rec["name"], "--timeout", str(ms)], check=False)
        time.sleep(POLL_SEC)


def inbox_dir(name):
    """The orchestrator's inbox is shared state; a worker's lives in its own .agent dir."""
    if name == ORCH:
        return STATE_DIR / "inbox" / ORCH
    return agent_dir(load(name)) / "inbox" if record_path(name).is_file() else None


def unread(name):
    box = inbox_dir(name)
    return sorted(box.glob("*.md")) if box and box.is_dir() else []


def send_one(sender, recipient, kind, src, message_id, live_status=None):
    box = inbox_dir(recipient)
    if box is None or recipient == sender:
        emit({"error": f"no agent {recipient} to message (or it is you)"}, 2)
    # Workers report to the orchestrator; talking to a peer needs the role's 'peers: true'.
    if sender != ORCH and recipient != ORCH:
        role = load(sender)["role"] if record_path(sender).is_file() else None
        if not (role and load_role(role)["peers"]):
            emit({"error": f"agent {sender} may only message {ORCH}: its role needs 'peers: true'"}, 2)
    src = Path(src)
    box.mkdir(parents=True, exist_ok=True)
    id_file = box / ".ids" / f"{sender}.{message_id}" if message_id is not None else None
    if id_file is not None and id_file.is_file():
        return {"to": recipient, "from": sender, "status": "duplicate", "id": message_id}
    if not src.is_file():
        emit({"error": f"{src} does not exist"}, 2)
    # File names are <ns>.<sender>.<kind>.md|read; agent names never contain a dot.
    if sum(1 for f in box.iterdir() if f.is_file() and len(f.name.split(".")) > 1
           and f.name.split(".")[1] == sender) >= MAX_INBOX:
        return {"to": recipient, "status": "inbox_full", "limit": MAX_INBOX}
    dest = box / f"{time.time_ns()}.{sender}.{kind}.md"
    dest.write_text(src.read_text())
    if id_file is not None:
        # A crash before recording the id may duplicate, never lose; overlapping retries can both deliver, so retries assume sequential calls.
        id_file.parent.mkdir(parents=True, exist_ok=True)
        id_file.touch()
    pushed = False
    # The orchestrator is not inside `wait` when a worker finishes: poke its pane. herdr rejects
    # the prompt (agent_blocked) before sending any key if a dialog is open, so mail then stays in the inbox.
    if recipient == ORCH and kind in PUSH_KINDS and record_path(sender).is_file() and load(sender).get("orch_pane"):
        text = f"Message from {sender} ({kind}): run `nakama inbox` and act on it."
        pushed = run(["herdr", "agent", "prompt", load(sender)["orch_pane"], text], check=False).returncode == 0
    # herdr hands a prompt to a working agent too (probed on pi): the pointer reaches it mid-task.
    if recipient != ORCH and (agent_status(recipient) if live_status is None else live_status) is not None:
        rel = dest.relative_to(load(recipient)["worktree"])
        text = f"Message from {sender} ({kind}): read {rel} and act on it. It overrides task.md where they conflict."
        pushed = run(["herdr", "agent", "prompt", recipient, text], check=False).returncode == 0
    return {"to": recipient, "from": sender, "kind": kind, "status": "sent", "file": str(dest), "pushed": pushed}


def cmd_send(a):
    sender = os.environ.get("NAKAMA_AGENT", ORCH)
    if a.id is not None and not SEND_ID_RE.fullmatch(a.id):
        emit({"error": "--id must contain 1-64 letters, numbers, underscores, or hyphens"}, 2)
    src = Path(a.file)
    if a.to == "@all":
        if sender != ORCH:
            emit({"error": "only the orchestrator may send to @all"}, 2)
        if not src.is_file():
            emit({"error": f"{src} does not exist"}, 2)
        recipients = []
        for rec in records():
            name = rec["name"]
            if name in (sender, ORCH):
                continue
            state = agent_status(name)
            if state is not None:
                recipients.append((name, state))
        results = [send_one(sender, name, a.kind, src, a.id, state)
                   for name, state in recipients]
        emit({"to": "@all", "from": sender, "kind": a.kind,
              "status": "sent" if results else "no_recipients", "results": results})
    result = send_one(sender, a.to, a.kind, src, a.id)
    emit(result)


def cmd_inbox(a):
    me = a.name or os.environ.get("NAKAMA_AGENT", ORCH)
    messages = []
    for f in unread(me):
        _, sender, kind, _ = f.name.split(".")
        messages.append({"from": sender, "kind": kind, "file": str(f), "text": f.read_text()})
        if not a.peek:
            f.rename(f.with_suffix(".read"))
    emit({"name": me, "messages": messages})


def cmd_extend(a):
    rec = load(a.name)
    if rec["budget_min"] + rec["extended_min"] + a.minutes > MAX_BUDGET_MIN:
        emit({"name": rec["name"], "status": "refused", "budget_min": rec["budget_min"],
              "extended_min": rec["extended_min"]})
    rec["extended_min"] += a.minutes
    save(rec)
    emit({"name": rec["name"], "status": "extended", "budget_min": rec["budget_min"],
          "extended_min": rec["extended_min"]})


def cmd_teardown(a):
    if a.force and not a.remove_worktree:
        emit({"error": "--force requires --remove-worktree"}, 2)
    rec = load(a.name)
    run(["herdr", "agent", "send-keys", rec["name"], "ctrl+c", "ctrl+c"], check=False)
    close_worker_surface(rec)
    removed = False
    reason = None
    forced = False
    if a.remove_worktree:
        if rec["branch"]:
            cmd = ["wt", "remove", rec["branch"], "--yes"]
            if a.force:
                cmd.append("--force")
                forced = True
            result = run(cmd, check=False)
            removed = result.returncode == 0
            if not removed:
                reason = (result.stderr + result.stdout)[-300:].strip()
        else:
            reason = "no worktree owned by this agent"
    rec["closed"] = True
    save(rec)
    out = {"name": rec["name"], "status": "closed", "worktree_removed": removed}
    if reason is not None:
        out["reason"] = reason
    if forced:
        out["forced"] = True
    emit(out)


def open_records():
    return [r for r in records() if not r["closed"]]


def cmd_list(a):
    emit({"agents": [{"name": r["name"], "role": r["role"], "kind": r["kind"], "worktree": r["worktree"],
                      "rounds": r["rounds"], "state": agent_status(r["name"])} for r in open_records()]})


def cmd_sweep(a):
    require_herdr()
    recs = open_records()
    known = {r["name"] for r in recs}
    metas = all_roles()
    # A custom --name matches no pattern; a record (open or closed) is what marks an agent as ours.
    recorded = {r["name"] for r in records()}
    stray = [n for n in live_names() if n not in known and (is_nakama_name(n, metas) or n in recorded)]
    listed = parse_external_json(
        run(["wt", "list", "--format", "json"]).stdout, "wt list", {"items": list})
    trees = find_key(listed, "items")
    branches = [t["branch"] for t in trees
                if isinstance(t.get("branch"), str) and t["branch"].startswith("agent/")]
    emit({"open_records": [{"name": r["name"], "state": agent_status(r["name"])} for r in recs],
          "stray_agents": stray, "agent_worktrees": branches})


def cmd_roles(a):
    emit({"roles": [{k: v for k, v in m.items() if k != "body"} for m in all_roles()]})


def global_ignore_file():
    configured = run(["git", "config", "--global", "core.excludesFile"], check=False).stdout.strip()
    if configured:
        return Path(os.path.expanduser(configured))
    return Path(os.environ.get("XDG_CONFIG_HOME") or str(HOME / ".config"), "git", "ignore")


def herdr_version():
    if not shutil.which("herdr"):
        return None
    match = re.search(r"(\d+)\.(\d+)\.(\d+)", run(["herdr", "--version"], check=False).stdout)
    return tuple(int(x) for x in match.groups()) if match else None


def cmd_doctor(a):
    checks = []

    def check(name, ok, fix, level="error"):
        checks.append({"check": name, "ok": bool(ok), "level": level, "fix": None if ok else fix})

    version = herdr_version()
    check("herdr >= 0.9.3", version and version >= MIN_HERDR, "install or upgrade herdr: https://herdr.dev")
    check("inside herdr", os.environ.get("HERDR_ENV") == "1", "run nakama from a herdr pane", "warn")
    for tool in ("wt", "git"):
        check(f"{tool} on PATH", shutil.which(tool), f"install {tool}")
    check("pi or claude on PATH", shutil.which("pi") or shutil.which("claude"), "install pi and/or Claude Code")
    if shutil.which("pi"):
        check("herdr pi integration", (HOME / ".pi/agent/extensions/herdr-agent-state.ts").is_file(),
              "herdr integration install pi")
    if shutil.which("claude"):
        check("herdr claude integration", (HOME / ".claude/hooks/herdr-agent-state.sh").is_file(),
              "herdr integration install claude")
    check("nakama on PATH", shutil.which("nakama"),
          'add to your shell profile: export PATH="$HOME/.local/bin:$PATH"', "warn")
    # Ask git in a scratch repo so any spelling of the pattern counts and only global excludes do.
    with tempfile.TemporaryDirectory(prefix="nakama-doctor-") as probe:
        run(["git", "init", "-q"], cwd=probe, check=False)
        asked = run(["git", "check-ignore", "-q", "--no-index", ".agent/x"], cwd=probe, check=False)
    ignore = global_ignore_file()
    check(".agent/ globally git-ignored", asked.returncode == 0,
          f"mkdir -p {ignore.parent} && echo '.agent/' >> {ignore}")
    top = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if top.returncode == 0:
        check(".worktreeinclude in this repo", Path(top.stdout.strip(), ".worktreeinclude").is_file(),
              "nakama init <gitignored files that worktrees need>", "warn")
    emit({"ok": all(c["ok"] for c in checks if c["level"] == "error"), "version": VERSION, "checks": checks})


def cmd_init(a):
    top = run(["git", "rev-parse", "--show-toplevel"], check=False)
    if top.returncode != 0:
        emit({"error": "not inside a git repository"}, 2)
    include = Path(top.stdout.strip(), ".worktreeinclude")
    lines = include.read_text().splitlines() if include.is_file() else []
    added = [p for p in a.patterns if p not in lines]
    if added:
        include.write_text("\n".join(lines + added) + "\n")
    exclude = Path(run(["git", "rev-parse", "--path-format=absolute", "--git-path", "info/exclude"]).stdout.strip())
    exclude.parent.mkdir(parents=True, exist_ok=True)
    current = exclude.read_text().splitlines() if exclude.is_file() else []
    if ".worktreeinclude" not in current:
        exclude.write_text("\n".join(current + [".worktreeinclude"]) + "\n")
    emit({"worktreeinclude": str(include), "patterns": lines + added, "added": added, "excluded_via": str(exclude)})


def main():
    p = argparse.ArgumentParser(
        prog="nakama",
        description="Run pi / Claude Code workers in herdr tabs, each in its own worktrunk worktree. "
                    "Every command prints one JSON object.",
        epilog="typical loop:\n"
               "  nakama launch builder fix-login        # → b1-fix-login\n"
               "  $EDITOR <dir>/task.md                  # format: skills/nakama/SKILL.md\n"
               "  nakama prompt b1-fix-login task.md\n"
               "  nakama wait b1-fix-login               # repeat while it says running\n"
               "  nakama teardown b1-fix-login\n\n"
               "run 'nakama <command> --help' for a command's options.",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"nakama {VERSION}")
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    s = sub.add_parser("launch", help="start a worker in its own herdr tab (and worktree)",
                       description="Start a worker. Defaults come from roles/<role>.md "
                                   "(~/.config/nakama/roles/ overrides the bundled roles); flags override them.")
    s.add_argument("role", help="role name, e.g. builder, reviewer, researcher (see 'nakama roles')")
    s.add_argument("slug", help="short task label; the agent name becomes <prefix><n>-<slug>")
    s.add_argument("--kind", choices=["pi", "claude"], help="agent CLI (default: the role's kind)")
    s.add_argument("--name", help="explicit agent name instead of the generated one")
    s.add_argument("--model", help="model id for that CLI (default: the role's model, if the kind matches)")
    s.add_argument("--base", default="HEAD", help="git ref the new worktree branches from (default: HEAD)")
    s.add_argument("--budget", type=int, metavar="MIN", help="time budget in minutes (default: the role's budget)")
    s.add_argument("--layout", choices=["tab", "split"], default="tab",
                   help="tab: the agent's own herdr tab (default); split: a pane beside yours")
    s.add_argument("--direction", choices=["right", "down"], default="right", help="split direction for --layout split")
    where = s.add_mutually_exclusive_group()
    where.add_argument("--join", metavar="AGENT", help="work in that agent's worktree, e.g. a reviewer in the builder's worktree")
    where.add_argument("--no-worktree", action="store_true", help="work in the current checkout")

    s = sub.add_parser("resume", help="restart a worker on its existing worktree and re-prime it")
    s.add_argument("name", help="agent name")

    s = sub.add_parser("prompt", help="send a task or fix file to a worker",
                       description="Send 'Read .agent/<name>/<file> and do it.' Returns busy while the agent is working.")
    s.add_argument("name", help="agent name")
    s.add_argument("file", help="task.md, or fix-N.md for a fix round (max 2)")
    s.add_argument("--answer", action="store_true", help="answer to needs_input; does not count as a round")

    s = sub.add_parser("wait", help="wait for a worker's result",
                       description="Return succeeded/partial/failed/needs_input/malformed/blocked/stalled/over_budget/message, "
                                   "or running when --timeout passes (call it again).")
    s.add_argument("name", help="agent name")
    s.add_argument("--timeout", type=float, default=280, metavar="SEC", help="seconds before returning running (default: 280)")

    s = sub.add_parser("send", help="message an agent, the orchestrator, or all live workers",
                       description="Drop a message file in the recipient's inbox. The orchestrator can use '@all' "
                                   "to reach every live worker. Optional --id KEY makes retries idempotent for "
                                   "that sender and recipient. The orchestrator's nakama wait returns 'message'; "
                                   "a worker reads it with nakama inbox. Workers may only message the orchestrator "
                                   "unless their role has 'peers: true'.")
    s.add_argument("to", help=f"agent name, '{ORCH}', or '@all' (orchestrator only)")
    s.add_argument("kind", choices=MESSAGE_KINDS, help="done: finished; ask: need a judgement; answer; info; blocker")
    s.add_argument("file", help="markdown file holding the message")
    s.add_argument("--id", help="optional idempotency key (1-64 letters, numbers, underscores, or hyphens)")

    s = sub.add_parser("inbox", help="read and clear unread messages",
                       description="Print unread messages for you (default: $NAKAMA_AGENT, else the orchestrator) "
                                   "and mark them read.")
    s.add_argument("name", nargs="?", help="agent name (default: yourself)")
    s.add_argument("--peek", action="store_true", help="do not mark messages read")

    s = sub.add_parser("extend", help="add minutes to a worker's time budget (max 180 in total)")
    s.add_argument("name", help="agent name")
    s.add_argument("minutes", type=int, help="minutes to add")

    s = sub.add_parser("teardown", help="stop a worker and close its tab")
    s.add_argument("name", help="agent name")
    s.add_argument("--remove-worktree", action="store_true", help="also remove its worktree (the branch is kept)")
    s.add_argument("--force", action="store_true", help="force worktree removal; requires --remove-worktree")

    sub.add_parser("list", help="list open workers and their herdr state")
    sub.add_parser("sweep", help="list orphaned workers and agent/* worktrees (kills nothing)")
    sub.add_parser("roles", help="list roles and the files they come from")
    sub.add_parser("doctor", help="check the setup and print fix commands")
    s = sub.add_parser("init", help="write this repo's .worktreeinclude, hidden from git",
                       description="Gitignored files new worktrees need (e.g. .env), copied in by 'wt step copy-ignored'.")
    s.add_argument("patterns", nargs="+", help="gitignore-style patterns")
    a = p.parse_args()
    {"launch": cmd_launch, "resume": cmd_resume, "prompt": cmd_prompt, "wait": cmd_wait, "send": cmd_send, "inbox": cmd_inbox, "extend": cmd_extend,
     "teardown": cmd_teardown, "list": cmd_list, "sweep": cmd_sweep, "roles": cmd_roles,
     "doctor": cmd_doctor, "init": cmd_init}[a.cmd](a)


if __name__ == "__main__":
    main()
